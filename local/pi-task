def make_name(text):
    import secrets
    words = [w for w in re.findall(r"[a-z0-9]+", text.lower()) if w not in STOPWORDS][:3]
    base = "-".join(words)[:24].strip("-") or "task"
    while True:
        name = f"{base}-{secrets.token_hex(2)}"
        if not (SESSIONS / name).exists():
            return name


def cmd_new(a):
    import uuid
    preflight()
    text = get_text(a, "prompt")
    if is_command(text):
        die("start a session with a task, not a slash command", 2)
    cwd = Path(a.cwd or os.getcwd()).expanduser().resolve()
    if not cwd.is_dir():
        die(f"no such directory: {cwd}", 2)
    if a.name and (not NAME_RE.fullmatch(a.name) or a.name == "last"):
        die("--name takes letters, digits, '.', '_' and '-', at most 64, and not 'last'", 2)
    name = a.name or make_name(text)
    if (SESSIONS / name).exists():
        die(f"a session named {name} exists already")
    tname = tmux_name(name)
    if tname in (panes() or {}) or any(s.tmux == tname for s in all_sessions()):
        die(f"tmux session {tname} is taken on the {TMUX_SOCKET} server; pick another name")
    prov, model, cfg, note = pick_model(a.model)
    thinking = check_thinking(a.thinking, cfg, model)
    sess = Session(name)
    try:
        sess.dir.mkdir(parents=True)
    except FileExistsError:
        die(f"a session named {name} exists already")
    sess.queue_dir.mkdir()
    sess.sent_dir.mkdir()
    now = time.time()
    hidden = a.hidden or (HIDDEN_DEFAULT and not a.window)
    prepare = getattr(a, "prepare", False)
    extra_prompt = a.append_system_prompt
    if prepare:
        extra_prompt = "\n\n".join(part for part in (extra_prompt, text) if part)
    write_json(sess.meta_path, {
        "name": name, "pi_session_id": str(uuid.uuid4()), "cwd": str(cwd), "created": now, "updated": now,
        "by": caller(), "parent": os.environ.get("CLAUDE_CODE_SESSION_ID") or os.environ.get("CODEX_THREAD_ID")
        or os.environ.get("PI_SESSION_ID"),
        "title": short(text.splitlines()[0], 100), "provider": prov, "model": model, "thinking": thinking,
        "hidden": hidden, "tmux": tname, "append_system_prompt": extra_prompt,
        "pi_args": shlex.split(a.pi_args) if a.pi_args else [], "next_seq": 1, "last_msg": None})
    if note:
        say(note)
    say(f"session {name}: {prov}/{model} · thinking {thinking} · {cwd}" + (" · hidden" if hidden else ""), a.quiet)
    if prepare:
        sess.launch(quiet=a.quiet)
        say("prepared: context loaded; no task sent. Type in the window or use pi-task send.", a.quiet)
        print(name)
        return 0
    [seq] = sess.enqueue([{"kind": "message", "text": text}])
    sess.launch(quiet=a.quiet)
    if a.bg:
        print(name)
        return 0
    return report(sess, wait_for(sess, seq, a.timeout, a.verbose, quiet=a.quiet), a, now, new=True)


def session_model(sess, a=None):
    """Make sure the session's model is served, switching to a served one if not. Returns the
    settings to change and a note. Exits 4 when no Qwen model is served."""
    m = sess.meta()
    want = (a.model if a and a.model else None) or f"{m['provider']}/{m['model']}"
    if not (a and a.model) and not find_model(want, *configured()):
        want = None                  # its model left models.json: pick as for a new session
    prov, model, cfg, note = pick_model(want)
    settings = {}
    if (prov, model) != (m["provider"], m["model"]):
        settings.update(provider=prov, model=model)
    thinking = a.thinking if a and a.thinking else m.get("thinking")
    if thinking not in model_levels(cfg):
        thinking = check_thinking(a.thinking if a and a.thinking else None, cfg, model)
    if thinking != m.get("thinking"):
        settings["thinking"] = thinking
    return settings, note


def settings_controls(settings):
    if not settings:
        return []
    item = {"kind": "control"}
    if "model" in settings:
        item["model"] = f"{settings['provider']}/{settings['model']}"
    if "thinking" in settings:
        item["thinking"] = settings["thinking"]
    return [item]


def cmd_send(a):
    preflight()
    sess = resolve(a.session)
    text = get_text(a, "message")
    focus = check_slash(text)
    if focus is not None:
        a.text, a.file = [focus] if focus else [], None
        return cmd_compact(a)
    settings, note = session_model(sess, a)
    if note:
        say(f"{sess.name}: {note}")
    items = ([{"kind": "interrupt"}] if a.interrupt else []) + settings_controls(settings)
    items.append({"kind": "message", "text": text, "deliver": "followUp" if a.after else "steer"})
    started = time.time()
    with sess.start_lock():
        restarted = renew(sess, a.quiet)
        seqs = sess.enqueue(items, settings)
        if settings:
            say(f"{sess.name}: now " + " · ".join(f"{k} {v}" for k, v in settings.items() if k != "provider"),
                a.quiet)
        sess.launch(window=False if restarted else None, quiet=a.quiet)
    if a.bg:
        say(f"{sess.name}: message queued", a.quiet)
        return 0
    return report(sess, wait_for(sess, seqs[-1], a.timeout, a.verbose, quiet=a.quiet), a, started)


def cmd_wait(a):
    sess = resolve(a.session)
    seq = sess.meta().get("last_msg")
    if not seq:
        die(f"nothing has been sent to {sess.name}")
    started = time.time()
    compact = is_compact(sess, seq)
    return report(sess, wait_for(sess, seq, a.timeout, a.verbose, compact=compact, quiet=a.quiet), a, started,
                  compact=compact)


def wait_many_failed(out, compact):
    """Match report's failure, interrupted-run and empty-answer exit rules."""
    last = out.replies[-1] if out.replies else None
    return (out.status in ("error", "interrupted") or out.aborted or
            bool(last and last.get("stop") == "error") or
            (out.status == "done" and not compact and not reply_text(out)))


def reported_usage(replies):
    """Sum every captured response; a missing or malformed count makes that sum unknown."""
    totals = {"response_count": len(replies)}
    for field in ("input", "output", "total"):
        values = [(r["usage"].get(field) if isinstance(r.get("usage"), dict) else None) for r in replies]
        totals[field + "_tokens"] = (sum(values) if values and
                                     all(type(v) is int and v >= 0 for v in values) else None)
    return totals


def write_wait_many_artifact(path, data):
    """Publish a complete private JSON file atomically, without replacing any existing path."""
    import tempfile
    fd, tmp = tempfile.mkstemp(prefix=f".{path.name}.", suffix=".tmp", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            os.fchmod(f.fileno(), 0o600)
            json.dump(data, f, ensure_ascii=False, indent=1)
            f.write("\n")
            f.flush()
            os.fsync(f.fileno())
        # Unlike replace(), link() atomically refuses even a destination created during the wait.
        os.link(tmp, path)
    finally:
        os.unlink(tmp)


def cmd_wait_many(a):
    """Observe frozen last messages concurrently, cancelling only observers when finished."""
    import math
    from concurrent.futures import FIRST_COMPLETED, ThreadPoolExecutor, wait
    from threading import Event

    if not 1 <= len(a.sessions) <= 32 or any(not ref.strip() for ref in a.sessions):
        die("wait-many needs 1 to 32 nonempty session names", 2)
    if not math.isfinite(a.timeout) or a.timeout < 0:
        die("--timeout must be a finite nonnegative number of seconds", 2)
    if not 0 <= a.reply_chars <= 8192:
        die("--reply-chars must be between 0 and 8192", 2)
    output = Path(a.output).expanduser().absolute() if a.output else None
    if output is not None and os.path.lexists(output):
        die(f"refusing to replace existing result {output}", 2)

    targets, names = [], set()
    for ref in a.sessions:
        sess = resolve(ref)          # Never resolve an alias or read last_msg again while waiting.
        if sess.name in names:
            die(f"duplicate resolved session {sess.name!r}", 2)
        names.add(sess.name)
        meta = sess.meta()
        seq = meta.get("last_msg")
        if type(seq) is not int or seq < 1:
            die(f"nothing has been sent to {sess.name}", 2)
        targets.append((sess, seq, meta.get("pi_session_id"), is_compact(sess, seq)))

    deadline = time.monotonic() + a.timeout
    cancel = Event()
    pool = ThreadPoolExecutor(max_workers=len(targets))
    futures = {}
    interrupted = False
    try:
        for index, (sess, seq, _, compact) in enumerate(targets):
            futures[pool.submit(wait_for, sess, seq, compact=compact, quiet=True, cancel_event=cancel)] = index
        pending = set(futures)
        while pending:
            done, pending = wait(pending, timeout=max(0, deadline - time.monotonic()),
                                 return_when=FIRST_COMPLETED)
            if any(f.exception() is not None or wait_many_failed(f.result(), targets[futures[f]][3])
                   for f in done):
                break
            if time.monotonic() >= deadline:
                break
    except KeyboardInterrupt:
        interrupted = True
    finally:
        cancel.set()
        while True:
            try:
                pool.shutdown(wait=True)
                break
            except KeyboardInterrupt:
                interrupted = True

    outcomes = [Outcome() for _ in targets]
    for future, index in futures.items():
        try:
            outcomes[index] = future.result()
        except (Exception, SystemExit) as e:
            outcomes[index].status, outcomes[index].error = "error", str(e)
    failed = any(wait_many_failed(out, target[3]) for target, out in zip(targets, outcomes))
    unfinished = any(out.status == "waiting" for out in outcomes)
    status = "interrupted" if interrupted else "error" if failed else "timeout" if unfinished else "done"
    results, raw_results = [], []
    for (sess, seq, sid, compact), out in zip(targets, outcomes):
        text = reply_text(out)
        last = out.replies[-1] if out.replies else None
        failed_answer = bool(last and last.get("stop") == "error" and not out.aborted)
        empty = out.status == "done" and not out.aborted and not failed_answer and not text and not compact
        stop = (last.get("stop") if last else None) or out.stop
        error = out.error or ("interrupted" if out.aborted or out.status == "interrupted" else
                              last.get("error") if failed_answer else None)
        if empty:
            error = no_answer(sess.name, stop)
        target_status = "error" if wait_many_failed(out, compact) else out.status
        if target_status == "waiting" and status == "timeout":
            target_status = "timeout"
        result = {"session": sess.name, "pi_session_id": sid, "seq": seq, "status": target_status,
                  "error": error, "stop_reason": stop, "answer_empty": empty,
                  "reply": text[:a.reply_chars], "reply_truncated": len(text) > a.reply_chars,
                  "usage": reported_usage(out.replies)}
        results.append(result)
        raw_results.append(dict(result, reply=text, reply_truncated=False, outcome=vars(out)))
    usage = {"response_count": sum(r["usage"]["response_count"] for r in results)}
    for field in ("input_tokens", "output_tokens", "total_tokens"):
        values = [r["usage"][field] for r in results]
        usage[field] = sum(values) if all(value is not None for value in values) else None
    data = {"schema_version": 1, "status": status, "targets": results,
            "usage_scope": "captured_assistant_responses", "usage": usage, "raw_artifact": None}
    if output is not None:
        try:
            write_wait_many_artifact(output, dict(data, targets=raw_results, raw_artifact=str(output)))
            data["raw_artifact"] = str(output)
        except OSError as e:
            data["status"], data["error"] = "error", f"cannot write result {output}: {e}"
    print(json.dumps(data, ensure_ascii=False, separators=(",", ":")), flush=True)
    return 0 if data["status"] == "done" else 3 if data["status"] == "timeout" else 1


def is_compact(sess, seq):
    """True if item `seq` is a compaction."""
    return any(r.get("seq") == seq and r.get("ev") in ("compacting", "compacted", "compact_failed")
               for r in Tail(sess.log_path).lines()) or any(
        item.get("seq") == seq and item["kind"] == "compact" for _, item in sess.queued())


def cmd_compact(a):
    preflight()
    sess = resolve(a.session)
    focus = " ".join(a.text).strip()
    settings, note = session_model(sess)     # the summary needs a served model too
    if note:
        say(f"{sess.name}: {note}")
    started = time.time()
    with sess.start_lock():
        restarted = renew(sess, a.quiet)
        seq = sess.enqueue(settings_controls(settings) + [{"kind": "compact", "text": focus}], settings)[-1]
        sess.launch(window=False if restarted else None, quiet=a.quiet)
    if a.bg:
        say(f"{sess.name}: compaction queued", a.quiet)
        return 0
    return report(sess, wait_for(sess, seq, a.timeout, a.verbose, compact=True, quiet=a.quiet), a, started,
                  compact=True)


def cmd_set(a):
    sess = resolve(a.session)
    m, st = sess.meta(), sess.state()
    if not a.model and not a.thinking:
        live = f" (running: {st.get('provider')}/{st.get('model')}, {st.get('thinking')})" if sess.alive() else ""
        print(f"model {m['provider']}/{m['model']} · thinking {m['thinking']}{live}")
        return 0
    if a.model:
        settings, note = session_model(sess, a)
        if note:
            die(f"{note.split(';')[0]}; not switching", EXIT_UNAVAILABLE)
    else:
        _, _, cfg = find_model(f"{m['provider']}/{m['model']}", *configured()) or die(
            f"{m['provider']}/{m['model']} is no longer in {PI_AGENT_DIR / 'models.json'}")
        settings = {"thinking": check_thinking(a.thinking, cfg, m["model"])}
    if not settings:
        say(f"{sess.name}: nothing to change")
        return 0
    what = " · ".join(f"{k} {v}" for k, v in settings.items() if k != "provider")
    seqs = sess.enqueue(settings_controls(settings), settings)
    if not seqs:
        say(f"{sess.name}: {what}; applies when pi starts again")
        return 0
    got = wait_controls(sess, seqs, 20)
    errors = [r.get("error") for r in got.values() if not r.get("ok")]
    if errors:
        say(f"{sess.name}: pi refused: {'; '.join(str(e) for e in errors)}")
        return 1
    if len(got) < len(seqs):
        say(f"{sess.name}: {what}; queued, not confirmed yet")
        return 0
    r = next(iter(got.values()))
    say(f"{sess.name}: now {r.get('model')} · thinking {r.get('thinking')}")
    return 0


def cmd_interrupt(a):
    sess = resolve(a.session)
    seqs = sess.enqueue([{"kind": "interrupt"}])
    if not seqs:
        say(f"{sess.name} is not running")
        return 0
    got = wait_controls(sess, seqs, 10)
    if not got:
        # The extension did not answer: press Esc in pi's TUI, as the user would.
        keys = tmux("send-keys", "-t", f"={sess.tmux}:", "Escape")
        say(f"{sess.name}: the pi-task extension did not answer; " +
            ("pressed Esc in pi's window" if keys.returncode == 0 else f"Esc failed too: {keys.stderr.strip()}"))
        return 0 if keys.returncode == 0 else 1
    elif not next(iter(got.values())).get("running"):
        say(f"{sess.name}: nothing was running")
    else:
        say(f"{sess.name}: interrupted")
    return 0


def cmd_stop(a):
    sess = resolve(a.session)
    if a.force:
        return force_stop(sess)
    if not sess.alive():
        cleanup(sess)
        dropped = discard(sess, "stopped")
        say(f"{sess.name} is not running" + (f"; dropped {plural(dropped, 'queued message')}" if dropped else ""))
        return 0
    sess.enqueue([{"kind": "stop"}])
    deadline = time.time() + 60
    while time.time() < deadline:
        if not sess.alive():
            cleanup(sess)
            say(f"{sess.name} stopped")
            return 0
        time.sleep(TICK)
    say(f"{sess.name} is still stopping; `{PROG} stop --force {sess.name}` kills it")
    return 1


def cleanup(sess):
    """End the session's tmux session once pi is gone, which closes its windows."""
    if sess.pane():
        tmux("kill-session", "-t", f"={sess.tmux}")


def force_stop(sess):
    pane = sess.pane()
    pid = pane["pid"] if pane and not pane["dead"] else None
    if pane:
        tmux("kill-session", "-t", f"={sess.tmux}")   # pi gets SIGHUP and shuts down
    deadline = time.time() + 5
    while pid_alive(pid) and time.time() < deadline:
        time.sleep(0.1)
    if pid_alive(pid):
        try:
            os.kill(pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
    discard(sess, "killed")
    say(f"{sess.name} killed")
    return 0


def discard(sess, reason):
    """For a session whose pi is gone: drop what is queued or was cut, so that recover leaves it
    alone, and fail whoever waits for it. Returns the number of messages dropped."""
    with sess.lock():
        left = sess.queued(sess.sent_dir) + sess.queued()
        for path, _ in left:
            path.unlink(missing_ok=True)
        seqs = [item["seq"] for _, item in left if item["kind"] in ("message", "compact")]
        st = sess.state()
        if seqs:
            append_log(sess.log_path, "dropped", seqs=seqs, reason=reason)
        if seqs or st.get("busy") or st.get("compacting") or st.get("cut") or reason == "killed":
            append_log(sess.log_path, "shutdown", reason=reason, stopping=True, cut=None)
        if st:
            write_json(sess.state_path, dict(st, busy=False, compacting=False, starting=None, pending=[], cut=None,
                                             stopped=st.get("stopped") or time.time(), updated=time.time()))
    return len(seqs)


def attested_runtime(sess, st, alive):
    """Only a live same-session PID/start/boot receipt attests a running build."""
    unknown = lambda reason: {"verified": False, "version": None, "source_revision": None, "reason": reason}
    receipt = st.get("runtime_identity")
    if not alive or st.get("stopped"):
        return unknown("not running")
    if not isinstance(receipt, dict) or type(receipt.get("schema")) is not int or receipt["schema"] != 1:
        return unknown("legacy or missing runtime receipt")
    pid = st.get("pid")
    if type(pid) is not int or pid <= 0 or type(receipt.get("pid")) is not int or receipt["pid"] != pid:
        return unknown("PID or process start mismatch")
    if not isinstance(receipt.get("start"), str) or not receipt["start"].isdigit() or process_start(pid) != receipt["start"]:
        return unknown("PID or process start mismatch")
    try:
        boot = Path("/proc/sys/kernel/random/boot_id").read_text().strip()
    except OSError:
        return unknown("boot identity unavailable")
    if not receipt.get("boot_id") or receipt["boot_id"] != boot:
        return unknown("boot identity mismatch")
    sid = st.get("session_id")
    if not isinstance(sid, str) or not sid or receipt.get("session_id") != sid or sess.meta().get("pi_session_id") != sid:
        return unknown("conversation identity mismatch")
    if not runs_pi(sess.dir, pid):
        return unknown("process ownership not verified")
    version = receipt.get("version")
    if not isinstance(version, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._+~-]{0,159}", version):
        return unknown("runtime version unavailable")
    source = receipt.get("source_revision")
    source = source if isinstance(source, str) and re.fullmatch(r"[a-f0-9]{40}", source) else None
    return {"verified": True, "version": version, "source_revision": source,
            "pid": pid, "start": receipt["start"], "boot_id": boot, "session_id": sid}


def cmd_status(a):
    sess = resolve(a.session)
    m, st, all_panes = sess.meta(), sess.state(), panes()
    alive = sess.alive(all_panes)
    state, cut = describe_state(sess, st, alive, all_panes), interruption(sess, st, alive)
    clients = sess.clients() if alive else []
    runtime_identity = attested_runtime(sess, st, alive)
    slot = None
    if state == "waiting":
        cap, _, users, line, _ = slot_view(slot_model(sess.name))
        slot = {"in_use": len(users), "cap": cap,
                "position": line.index(sess.name) + 1 if sess.name in line else None}
    if a.json:
        print(json.dumps({"session": sess.name, "state": state, "interruption": cut, "slot": slot, "meta": m,
                          "runtime": st, "runtime_identity": runtime_identity, "process_running": alive, "windows": len(clients),
                          "pane": sess.pane(all_panes)}, ensure_ascii=False, indent=1))
        return 0
    tokens = st.get("tokens") or {}
    shown = (f"waiting for a Qwen slot ({waiting_note(sess.name, users, line, cap)})" if slot else state)
    rows = [("pi version", (runtime_identity["version"] + " (running; PID/start/boot verified)"
                            if runtime_identity["verified"] else "unknown (" + runtime_identity["reason"] + ")")),
            ("source", runtime_identity.get("source_revision") or "unknown"),
            ("state", shown + (f" ({cut})" if cut else "")
                      + (f" · last: {st['activity']} ({fmt_dur(time.time() - st['activity_at'])} ago)"
                         if alive and st.get("activity") and st.get("activity_at") else "")),
            ("model", f"{st.get('provider') or m['provider']}/{st.get('model') or m['model']} · thinking "
                      f"{st.get('thinking') or m['thinking']}"
                      + ("" if alive else f" (next run: {m['provider']}/{m['model']}, {m['thinking']})")),
            ("context", f"{fmt_tokens(st.get('ctx'))} of {fmt_tokens(st.get('ctx_window'))} tokens · used "
                        f"{fmt_tokens(tokens.get('input'))} in, {fmt_tokens(tokens.get('output'))} out"),
            ("directory", m.get("cwd")),
            ("started", f"{fmt_time(m.get('created'))} by {m.get('by')}"),
            ("process", (f"running (pi pid {st.get('pid')})" if alive else
                         f"not running; `{PROG} recover` resumes it" if cut else
                         "not running; the next message starts it")),
            ("window", (plural(len(clients), "window") + " open" if clients else
                        f"none; `{PROG} show {sess.name}` opens one") if alive else "-"),
            ("tmux", f"tmux -L {TMUX_SOCKET} attach -t {sess.tmux}")]
    queued = len(sess.messages_waiting())
    if queued:
        rows.append(("queued", plural(queued, "item")))
    if alive and old_extension(sess, st):
        rows.append(("extension", "predates the cap on sessions in use: its runs start without a Qwen slot; "
                                  "the next message while it is idle restarts pi"))
    if st.get("error"):
        rows.append(("last error", st["error"]))
    if st.get("last_text"):
        rows.append(("last answer", short(st["last_text"], 200)))
    rows += [("pi session", st.get("session_file") or m.get("pi_session_id")), ("files", str(sess.dir))]
    print(f"{sess.name}: {m.get('title')}")
    for key, value in rows:
        print(f"  {key:<11} {value}")
    return 0


def cmd_list(a):
    rows, all_panes = [], panes()
    for sess in all_sessions():
        m, st = sess.meta(), sess.state()
        alive = sess.alive(all_panes)
        rows.append((last_active(sess), sess, m, st, describe_state(sess, st, alive, all_panes),
                     interruption(sess, st, alive)))
    rows.sort(key=lambda r: r[0], reverse=True)
    if not a.all:
        rows = rows[:20]
    slots = slot_view() if any(r[4] == "waiting" for r in rows) else None

    def slot(name):
        table = slots[4]
        model = slot_model(name, table["waiters"].get(name))
        cap, _ = read_cap(model)
        users, line = slot_users(table, model), slots_line(table, model)
        return {"in_use": len(users), "cap": cap, "position": line.index(name) + 1 if name in line else None}

    if a.json:
        print(json.dumps([{"session": s.name, "state": state, "interruption": cut,
                           **({"slot": slot(s.name)} if state == "waiting" else {}),
                           "model": f"{m.get('provider')}/{m.get('model')}", "thinking": m.get("thinking"),
                           "context_tokens": st.get("ctx"), "updated": t, "cwd": m.get("cwd"),
                           "title": m.get("title"), "by": m.get("by"), "hidden": m.get("hidden")}
                          for t, s, m, st, state, cut in rows], ensure_ascii=False, indent=1))
        return 0
    if not rows:
        print("no sessions")
        return 0
    table = [("NAME", "STATE", "MODEL", "CONTEXT", "ACTIVE", "TITLE")]
    for t, s, m, st, state, _ in rows:
        if state == "waiting":
            info = slot(s.name)
            state = f"waiting ({info['in_use']} of {info['cap']} in use)"
        table.append((s.name, state, f"{m.get('model')}/{m.get('thinking')}", fmt_tokens(st.get("ctx")),
                      fmt_dur(time.time() - t) + " ago", m.get("title") or ""))
    widths = [max(len(r[i]) for r in table) for i in range(5)]
    for r in table:
        print("  ".join(r[i].ljust(widths[i]) for i in range(5)) + "  " + short(r[5], 60))
    return 0


def cmd_cap(a):
    model = model_id(a.model)
    probes, _ = configured()
    if model and "/" in model and not any(model in p["configured"] for p in probes):
        provider, mid = model.split("/", 1)
        if any(p["provider"] == provider for p in probes):
            model = mid
    if a.model is not None and (not model or not model.strip("/")):
        die("MODEL must name a model ID", 2)
    cap_file = CAP_FILE.with_name(MODEL_CAPS_NAME) if model else CAP_FILE
    if a.cap is not None:
        if a.cap < 1:
            die("the cap is a whole number from 1 up", 2)
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        with Flock(SLOTS_LOCK):
            if model:
                caps, problem = read_model_caps()
                if problem:
                    die(problem + "; refusing to overwrite existing overrides")
                caps[model] = a.cap
                write_json(cap_file, caps)
            else:
                tmp = CAP_FILE.with_name(f".{CAP_FILE.name}.{os.getpid()}.tmp")
                tmp.write_text(f"{a.cap}\n", encoding="utf-8")
                os.replace(tmp, CAP_FILE)
            table = slots_read()
            table["gen"] += 1            # waiting sessions ask again at once
            write_json(SLOTS_FILE, table)
    cap, problem, users, line, table = slot_view(model if model else ALL_MODELS)
    old = [sess.name for sess in all_sessions() if old_extension(sess)]
    holders, now = table["holders"], time.time()
    order = sorted(users, key=lambda n: (n not in holders, holders.get(n, {}).get("since") or 0, n))
    user_models = {n: slot_model(n, holders.get(n)) for n in users}
    waiter_models = {n: slot_model(n, table["waiters"][n]) for n in line}
    overrides, _ = read_model_caps()
    known = ({model} if model else
             set(overrides) | {mid for p in probes for mid in p["configured"]} |
             set(user_models.values()) | set(waiter_models.values()))
    models = {mid if mid is not None else "(unknown)": {
        "cap": read_cap(mid)[0], "in_use": sum(m == mid for m in user_models.values()),
        "waiting": sum(m == mid for m in waiter_models.values()), "override": mid in overrides}
        for mid in sorted(known, key=lambda m: m or "")}
    if a.json:
        print(json.dumps({"cap": cap, "file": str(cap_file), "problem": problem, "model": model, "models": models,
                          "in_use": [{"session": n, "what": users[n], "slot": n in holders,
                                      "since": holders.get(n, {}).get("since"), "old_extension": n in old,
                                      "model": user_models[n]}
                                     for n in order],
                          "waiting": [{"session": n, "queued": table["waiters"][n].get("since"),
                                       "model": waiter_models[n]} for n in line],
                          "old_extension": old}, ensure_ascii=False, indent=1))
        return 0
    if problem:
        say(problem)
    scope = f"for {model}" if model else "per model without its own cap"
    print(f"cap: at most {plural(cap, 'session')} in use at once {scope}, every caller's ({cap_file})")
    for mid, info in models.items():
        print(f"  {mid}: cap {info['cap']}, in use {info['in_use']}, waiting {info['waiting']}"
              + (" (model override)" if info["override"] else " (default cap)"))
    width = max([len(n) for n in [*users, *line]] or [0])
    if model or len(set(user_models.values()) | set(waiter_models.values())) <= 1:
        actual_cap = read_cap(next(iter(user_models.values()), next(iter(waiter_models.values()), model)))[0]
        print(f"in use: {len(users)} of {actual_cap}")
    else:
        print(f"in use: {len(users)} across models")
    for n in order:
        if n in holders:
            what = f"{users[n]}, slot held for {fmt_dur(now - (holders[n].get('since') or now))}"
        else:
            what = f"{users[n]} without a slot: " + ("its pi-task extension predates the cap" if n in old
                                                     else "a run started in its window")
        print(f"  {n:<{width}}  {what} (model: {user_models[n] or 'unknown'})")
    print(f"waiting: {len(line)}" + (", first come first served" if len(line) > 1 else ""))
    for i, n in enumerate(line, 1):
        w = table["waiters"][n]
        print(f"  {i}. {n:<{width}}  queued {fmt_dur(now - (w.get('since') or now))} ago"
              + (" (pi starting)" if w.get("pid") is None else ""))
        print(f"      model: {waiter_models[n] or 'unknown'}")
    if old:
        print(f"older extension, runs start without a slot until pi-task restarts pi at its next message "
              f"while idle: {', '.join(old)}")
    return 0


def session_file(sess):
    path = sess.state().get("session_file")
    if path and Path(path).exists():
        return Path(path)
    sid = sess.meta().get("pi_session_id")
    return next(iter(sorted((PI_AGENT_DIR / "sessions").glob(f"*/*_{sid}.jsonl"))), None) if sid else None


def render_entry(d, full=False):
    """Readable lines for one entry of a pi session file."""
    cut = (lambda t, n: str(t).strip()) if full else short
    kind = d.get("type")
    if kind == "message":
        msg = d.get("message") or {}
        role, content = msg.get("role"), msg.get("content")
        if role == "user":
            text = content if isinstance(content, str) else "\n".join(
                c.get("text", "") for c in content or [] if c.get("type") == "text")
            return [f"you> {cut(text, 300)}"]
        if role == "assistant":
            out = []
            for c in content or []:
                if c.get("type") == "text" and c.get("text", "").strip():
                    out.append(f"qwen> {cut(c['text'], 300)}")
                elif c.get("type") == "toolCall":
                    args = c.get("arguments") or {}
                    what = next((args[k] for k in ("command", "path", "file_path", "pattern") if args.get(k)),
                                json.dumps(args, ensure_ascii=False))
                    out.append(f"  {c.get('name')}: {cut(what, 160)}")
            if msg.get("stopReason") == "error":
                out.append(f"-- error: {cut(msg.get('errorMessage') or '', 300)}")
            return out
        if role == "toolResult" and full:
            text = "\n".join(c.get("text", "") for c in content or [] if c.get("type") == "text")
            return [f"    -> {cut(text, 2000)}"]
        return []
    if kind == "compaction":
        return [f"-- compacted: {fmt_tokens(d.get('tokensBefore'))} tokens summarized"]
    if kind == "model_change":
        return [f"-- model {d.get('provider')}/{d.get('modelId')}"]
    if kind == "thinking_level_change":
        return [f"-- thinking {d.get('thinkingLevel')}"]
    return []


def cmd_log(a):
    sess = resolve(a.session)
    path = session_file(sess)
    if not path:
        die(f"{sess.name} has no pi conversation yet")
    tail = Tail(path)
    lines = [line for d in tail.lines() for line in render_entry(d, a.full)]
    for line in lines[-a.lines:] if a.lines else lines:
        print(line)
    if a.follow:
        try:
            while True:
                for d in tail.lines():
                    for line in render_entry(d, a.full):
                        print(line, flush=True)
                time.sleep(0.5)
        except KeyboardInterrupt:
            pass
    return 0


def cmd_result(a):
    sess = resolve(a.session)
    seq = sess.meta().get("last_msg")
    if not seq:
        die(f"nothing has been sent to {sess.name}")
    out = Outcome()
    compact = is_compact(sess, seq)
    done = scan(Tail(sess.log_path).lines(), seq, out, compact=compact)
    text = reply_text(out)
    if text:
        print(text)
    if out.status == "error":
        say(f"{sess.name} error: {out.error}")
        return 1
    if not done:
        say(f"{sess.name} is {describe_state(sess)}; " + ("this is its answer so far" if text else "no answer yet"))
        return 3
    last = out.replies[-1] if out.replies else None
    if out.aborted or (last and last.get("stop") == "error"):
        say(f"{sess.name}: the run ended " + ("interrupted" if out.aborted else f"in an error: {last.get('error')}"))
        return 1
    if not text and not compact:
        say(no_answer(sess.name, stop_reason(out, sess.state())))
        return 1
    return 0


def ensure_running(sess, a):
    """Start pi for show and attach when it does not run. Dies for an interrupted session."""
    if sess.alive():
        return False
    cut = interruption(sess)
    if cut:
        die(f"{sess.name} was cut by a crash or reboot ({cut}); `{PROG} recover {sess.name}` resumes it")
    preflight()
    settings, note = session_model(sess)
    if note:
        say(f"{sess.name}: {note}")
    if settings:
        sess.enqueue([], settings)
    sess.launch(window=False)
    return True


def cmd_show(a):
    sess = resolve(a.session)
    ensure_running(sess, a)
    if sess.clients() and not a.new:
        say(f"{sess.name} has a window open already; --new opens another")
        return 0
    return 0 if sess.open_window() else 1


def cmd_hide(a):
    sess = resolve(a.session)
    say(f"{sess.name}: windows closed; pi keeps running" if sess.close_windows() else f"{sess.name} has no window open")
    return 0


def cmd_attach(a):
    sess = resolve(a.session)
    ensure_running(sess, a)
    if not sys.stdin.isatty():
        die("attach needs a terminal; `pi-task show NAME` opens a window", 2)
    exe = shutil.which("tmux")
    os.execvpe(exe, [exe, "-L", TMUX_SOCKET, "attach-session", "-t", f"={sess.tmux}"], child_env())


def models_probe():
    """One probe round, as models does: (probes, settings, pick, why)."""
    probes, settings = availability()
    why = None
    try:
        pick = choose_model()
    except Unavailable as e:
        pick = None
        why = str(e)
    return probes, settings, pick, why


def models_report(probes, settings, pick, why, as_json):
    """What models prints for one probe round: 0 when a Qwen model is served."""
    default = f"{settings.get('defaultProvider')}/{settings.get('defaultModel')}"
    if as_json:
        print(json.dumps({"providers": [{"provider": p["provider"], "url": p["url"], "error": p["error"],
                                         "served": p["served"], "configured": sorted(p["configured"])}
                                        for p in probes],
                          "pi_default": default, "pick": f"{pick[0]}/{pick[1]}" if pick else None,
                          "pick_thinking": model_levels(pick[2])[-1] if pick else None,
                          "note": pick[3] if pick else why}, ensure_ascii=False, indent=1))
        return 0 if pick else EXIT_UNAVAILABLE
    for p in probes:
        print(f"{p['provider']} ({p['url']}): " + (f"unreachable: {p['error']}" if p["error"] else
                                                   "serves " + (", ".join(p["served"]) or "nothing")))
        for mid, cfg in p["configured"].items():
            mark = "served" if mid in p["served"] else "not served"
            print(f"  {p['provider']}/{mid}: {mark} · thinking {', '.join(model_levels(cfg))}"
                  + (" · pi's default" if f"{p['provider']}/{mid}" == default else ""))
        for mid in p["served"]:
            if mid not in p["configured"]:
                print(f"  {p['provider']}/{mid}: served, not in models.json")
    if pick:
        print(f"new sessions get {pick[0]}/{pick[1]} at thinking {model_levels(pick[2])[-1]}"
              + (f" ({pick[3]})" if pick[3] else ""))
        return 0
    print(why)
    return EXIT_UNAVAILABLE


def cmd_models(a):
    if not a.wait and (a.interval is not None or a.timeout is not None):
        die("--interval and --timeout go with --wait", 2)
    if not a.wait:
        return models_report(*models_probe(), a.json)
    interval = 60 if a.interval is None else a.interval
    if interval <= 0:
        die(f"--interval must be more than 0 s, got {a.interval:g}", 2)
    deadline = time.monotonic() + a.timeout if a.timeout is not None else None
    say(f"waiting for a Qwen model to be served, probing every {interval:g} s")
    try:
        while True:
            probes, settings, pick, why = models_probe()
            if pick:
                return models_report(probes, settings, pick, why, a.json)
            now = time.monotonic()
            if deadline is not None and now >= deadline:
                say(f"no Qwen model served after {a.timeout:g} s")
                return EXIT_UNAVAILABLE
            time.sleep(interval if deadline is None else min(interval, deadline - now))
    except KeyboardInterrupt:
        raise SystemExit(130)


def cmd_rm(a):
    for ref in a.sessions:
        sess = resolve(ref)
        if sess.alive():
            if not a.force:
                die(f"{sess.name} is running; stop it first, or pass --force")
            force_stop(sess)
        cleanup(sess)
        shutil.rmtree(sess.dir)
        say(f"removed {sess.name}; pi's conversation stays in {PI_AGENT_DIR / 'sessions'}")
    return 0


def cmd_recover(a):
    if not a.dry_run:
        preflight()
    boot = boot_time()
    found = []
    for sess in [resolve(ref) for ref in a.sessions] if a.sessions else all_sessions():
        cut = interruption(sess)
        if not cut:
            if a.sessions:
                print(f"{sess.name} is {describe_state(sess)}: nothing to resume")
            continue
        found.append((sess, cut))
    if a.dry_run:
        for sess, cut in found:
            print(f"would resume {sess.name}: {cut}")
    for sess, cut in [] if a.dry_run else found:
        settings, note = session_model(sess)
        if note:
            say(f"{sess.name}: {note}")
        note_text = RESUME_PROMPT.format(boot=boot)
        if any(sess.sent_dir.glob("*.json")) or sess.messages_waiting():
            note_text += RESENT_NOTE
        # The check runs again under the queue lock, so two recovers never resume a session twice.
        item = {"kind": "message", "text": note_text, "first": True}
        if sess.enqueue([item], settings, only_if=lambda s=sess: interruption(s)):
            sess.launch()
            print(f"resumed {sess.name}: {cut}")
        else:
            print(f"skipped {sess.name}: it started again meanwhile")
    if not found:
        if not a.sessions:
            print("no session was cut by a crash or reboot")
    elif a.dry_run:
        again = " ".join([PROG, "recover", *a.sessions])
        print(f"{plural(len(found), 'session')} to resume; `{again}` resumes them. The machine booted at {boot}.")
    else:
        print(f"The machine booted at {boot}. Follow a session with `{PROG} wait NAME`.")
    return 0


def cmd_exec(name):
    """Run pi for a session; the session's tmux pane runs this and pi takes its place."""
    sess = Session(name)
    m = sess.meta()
    # pi gets the environment of the pi-task command that started it, as claude-task's sessions
    # do, and so do PI_TASK_PI and PI_TASK_EXTENSION here. That command left it in env.json; the
    # file goes as soon as it is read.
    env_file = sess.dir / "env.json"
    env = read_json(env_file) or dict(os.environ)
    env_file.unlink(missing_ok=True)
    env = {k: v for k, v in env.items() if k not in PARENT_ENV}
    exe = pi_bin(env)
    if not exe:
        print(f"{PROG}: cannot resolve the current managed Pi release", file=sys.stderr)
        return 127
    env["PI_TASK_PI"] = exe
    release = Path(exe).parent.parent.parent
    versioned_extension = release / "pi-task-extension.ts"
    has_versioned_extension = (Path(exe).parent.name == ".bin" and Path(exe).parent.parent.name == "node_modules"
                               and versioned_extension.is_file()
                               and versioned_extension.resolve().is_relative_to(release.resolve()))
    extension = env.get("PI_TASK_EXTENSION") or (str(versioned_extension) if has_versioned_extension else
                str(Path(os.path.realpath(__file__)).with_name("pi-task-extension.ts")))
    if not m:
        print(f"{PROG}: cannot start pi: no session {name}", file=sys.stderr)
        return 127
    prompt = DELEGATED_PROMPT.format(name=name)
    if m.get("append_system_prompt"):
        prompt += "\n\n" + m["append_system_prompt"]
    args = [exe, "--session-id", m["pi_session_id"], "--name", name, "--model", f"{m['provider']}/{m['model']}",
            "--thinking", m["thinking"], "-e", extension, "--append-system-prompt", prompt,
            "--approve" if trusted(m["cwd"]) else "--no-approve", *m.get("pi_args", [])]
    # The extension asks this script for a Qwen slot before each run (`pi-task _slot`).
    env.update(PI_TASK_DIR=str(sess.dir), PI_TASK_NAME=name, PI_TASK_CLI=os.path.realpath(__file__),
               PI_TASK_PYTHON=sys.executable)
    try:
        os.chdir(m["cwd"])
        os.execvpe(exe, args, env)
    except OSError as e:
        print(f"{PROG}: cannot start pi ({exe}) in {m['cwd']}: {e}", file=sys.stderr)
        return 127


# ---------------------------------------------------------------- arguments

def build_parser():
    """The top-level parser, and each command's own parser by name and alias."""
    p = argparse.ArgumentParser(prog=PROG, description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", metavar="COMMAND")
    commands = {}

    def command(name, func, help_, aliases=()):
        sp = sub.add_parser(name, help=help_, description=help_, aliases=list(aliases))
        sp.set_defaults(func=func)
        for n in (name, *aliases):
            commands[n] = sp
        return sp

    def settings_opts(sp, new):
        dflt = (lambda v: f" (default: {v})") if new else (lambda v: "")
        sp.add_argument("-m", "--model", help="provider/id, an ID, or a unique part of one, from ~/.pi/agent/models.json"
                                              + dflt("the served one of: qwen3.8-flash-next, PI_TASK_MODEL, pi's default, any Qwen"))
        sp.add_argument("-e", "--thinking", "--effort", dest="thinking", metavar="LEVEL",
                        help="off, minimal, low, medium, high, xhigh or max, as the model maps them"
                             + dflt("the highest the model maps"))

    def wait_opts(sp):
        sp.add_argument("--bg", action="store_true", help="queue it and return at once")
        sp.add_argument("--timeout", type=float, metavar="SEC",
                        help="stop waiting after SEC seconds and exit 3; the session keeps working")
        sp.add_argument("-v", "--verbose", action="store_true", help="show pi's steps on stderr while waiting")
        sp.add_argument("-q", "--quiet", action="store_true", help="no status lines on stderr")
        sp.add_argument("--json", action="store_true", help="print the outcome as one JSON object")

    def text_opts(sp, what):
        sp.add_argument("text", nargs="*", metavar=what.upper(), help=f"the {what} (else -f FILE or stdin)")
        sp.add_argument("-f", "--file", help=f"read the {what} from FILE ('-' means stdin)")

    sp = command("new", cmd_new, "start a session, wait and print the answer")
    sp.add_argument("-n", "--name", help="session name (default: from the prompt's first words)")
    sp.add_argument("-C", "--cwd", metavar="DIR", help="directory to work in (default: the current one)")
    settings_opts(sp, True)
    sp.add_argument("--hidden", action="store_true", help="open no window; `pi-task show NAME` opens one later")
    sp.add_argument("--window", action="store_true", help="open a window even when PI_TASK_HIDDEN=1")
    sp.add_argument("--prepare", action="store_true", help="open idle with the prompt as persistent context; send no message and return immediately")
    sp.add_argument("--append-system-prompt", metavar="TEXT", help="extra system prompt text")
    sp.add_argument("--pi-args", metavar="ARGS", help="more pi CLI flags, as one shell-quoted string")
    text_opts(sp, "prompt")
    wait_opts(sp)

    sp = command("send", cmd_send, "send a follow-up and wait for the answer")
    sp.add_argument("session", metavar="NAME")
    settings_opts(sp, False)
    sp.add_argument("-i", "--interrupt", action="store_true", help="interrupt the current run first, like Esc")
    sp.add_argument("--after", action="store_true",
                    help="while pi works, deliver it when pi has finished (a follow-up), not after the "
                         "current tool calls (a steer)")
    text_opts(sp, "message")
    wait_opts(sp)

    sp = command("wait", cmd_wait, "wait until the session is idle; print the answer to the last message")
    sp.add_argument("session", metavar="NAME")
    sp.add_argument("--timeout", type=float, metavar="SEC", help="stop waiting after SEC seconds and exit 3")
    sp.add_argument("-v", "--verbose", action="store_true", help="show pi's steps on stderr while waiting")
    sp.add_argument("-q", "--quiet", action="store_true", help="no status lines on stderr")
    sp.add_argument("--json", action="store_true", help="print the outcome as one JSON object")

    sp = command("wait-many", cmd_wait_many, "observe frozen last messages; return early on failure (JSON output)")
    sp.add_argument("sessions", nargs="+", metavar="NAME")
    sp.add_argument("--timeout", type=float, required=True, metavar="SEC", help="group deadline in seconds; exit 3")
    sp.add_argument("--json", action="store_true", help="accepted for explicitness; output is always JSON")
    sp.add_argument("--reply-chars", type=int, default=1600, metavar="N", help="reply characters per target (0 to 8192; default 1600)")
    sp.add_argument("--output", metavar="FILE", help="atomically create a private artifact with full replies and raw outcomes")

    sp = command("result", cmd_result, "print the answer to the last message without waiting")
    sp.add_argument("session", metavar="NAME")

    sp = command("compact", cmd_compact, "compact the conversation; waits for the current run")
    sp.add_argument("session", metavar="NAME")
    sp.add_argument("text", nargs="*", metavar="FOCUS", help="what the summary should keep")
    wait_opts(sp)

    sp = command("set", cmd_set, "change model or thinking level; no options: show them")
    sp.add_argument("session", metavar="NAME")
    settings_opts(sp, False)

    sp = command("interrupt", cmd_interrupt, "stop the current run, like Esc; the session stays usable")
    sp.add_argument("session", metavar="NAME")

    sp = command("stop", cmd_stop, "drop queued messages, end pi and close its windows; `send` starts it again")
    sp.add_argument("session", metavar="NAME")
    sp.add_argument("--force", action="store_true", help="kill pi at once")

    sp = command("status", cmd_status, "show what a session is doing")
    sp.add_argument("session", metavar="NAME")
    sp.add_argument("--json", action="store_true")

    sp = command("with-slot", cmd_with_slot, "run an external caller under the shared per-model cap and FIFO")
    sp.add_argument("--model", required=True, metavar="MODEL", help="exact model ID used by this caller (no probe)")
    sp.add_argument("--name", required=True, metavar="LABEL", help="display label; each invocation has a unique lease")
    sp.add_argument("command", nargs=argparse.REMAINDER, metavar="-- COMMAND [ARG...]")

    sp = command("list", cmd_list, "list sessions, most recently active first", aliases=["ls"])
    sp.add_argument("-a", "--all", action="store_true", help="all sessions (default: the 20 latest)")
    sp.add_argument("--json", action="store_true")

    sp = command("log", cmd_log, "show the conversation from pi's session file: messages, answers, tool calls")
    sp.add_argument("session", metavar="NAME")
    sp.add_argument("-n", "--lines", type=int, default=40, help="show the last N lines (default 40; 0: all)")
    sp.add_argument("-f", "--follow", action="store_true", help="keep printing new lines")
    sp.add_argument("--full", action="store_true", help="untruncated text, with tool results")

    sp = command("show", cmd_show, "open a gnome-terminal window on the session; starts pi if it is stopped")
    sp.add_argument("session", metavar="NAME")
    sp.add_argument("--new", action="store_true", help="open another window even if one is open")

    sp = command("hide", cmd_hide, "close the session's windows; pi keeps running")
    sp.add_argument("session", metavar="NAME")

    sp = command("attach", cmd_attach, "watch and type in this terminal (tmux attach); starts pi if it is stopped")
    sp.add_argument("session", metavar="NAME")

    sp = command("cap", cmd_cap, "show each model's cap and use, shared by every caller; N sets the default "
                                 "cap, or MODEL's own cap with -m")
    sp.add_argument("cap", nargs="?", type=int, metavar="N", help=f"sessions in use per model (default {DEFAULT_CAP})")
    sp.add_argument("-m", "--model", metavar="MODEL", help="model ID or provider/ID; show or set its own cap")
    sp.add_argument("--json", action="store_true")

    sp = command("models", cmd_models, "list what the configured providers serve now, and what new would pick")
    sp.add_argument("--json", action="store_true")
    sp.add_argument("--wait", action="store_true",
                    help="keep probing until a Qwen model is served, then print and exit 0")
    sp.add_argument("--interval", type=float, metavar="SEC",
                    help="with --wait: probe every SEC seconds (default 60)")
    sp.add_argument("--timeout", type=float, metavar="SEC",
                    help="with --wait: give up after SEC seconds and exit 4 (default: wait forever)")

    sp = command("rm", cmd_rm, "forget sessions (pi's own session files stay)")
    sp.add_argument("sessions", nargs="+", metavar="NAME")
    sp.add_argument("--force", action="store_true", help="kill running sessions first")

    sp = command("recover", cmd_recover, "restart the sessions a crash or reboot cut: those that were working "
                                         "or had queued messages and have no pi now")
    sp.add_argument("sessions", nargs="*", metavar="NAME", help="only these sessions (default: all)")
    sp.add_argument("--dry-run", action="store_true", help="list them, start nothing")
    return p, commands


def main():
    if sys.argv[1:2] == ["_exec"]:
        return cmd_exec(sys.argv[2])
    if sys.argv[1:2] == ["_slot"]:
        return cmd_slot(sys.argv[2:])
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    parser, commands = build_parser()
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help", "help"):
        parser.print_help()
        return 0
    if argv[0] not in commands:
        parser.error(f"unknown command {argv[0]!r}")
    # Parsing each command on its own lets options follow the text: send NAME "..." --bg
    parse = commands[argv[0]].parse_args if argv[0] == "with-slot" else commands[argv[0]].parse_intermixed_args
    a = parse(argv[1:])
    try:
        return a.func(a)
    except OSError as e:
        if e.errno not in WRITE_BLOCKED or not e.filename:
            raise
        hint = (" The Codex sandbox blocks this: run the same pi-task command with escalated permissions."
                if caller() == "codex" else "")
        die(f"cannot write {e.filename}: {e.strerror}.{hint}")


if __name__ == "__main__":
    sys.exit(main() or 0)
