# ---------------------------------------------------------------- helpers

def die(msg, code=1):
    print(f"{PROG}: {msg}", file=sys.stderr, flush=True)
    sys.exit(code)


def say(msg, quiet=False):
    """A status line for the caller, on stderr."""
    if not quiet:
        print(f"[{PROG}] {msg}", file=sys.stderr, flush=True)


def read_json(path, default=None):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def write_json(path, data):
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=1, ensure_ascii=False)
        f.write("\n")
    os.replace(tmp, path)


def append_log(path, ev, **data):
    with open(path, "a", encoding="utf-8") as f:
        f.write(json.dumps(dict(ev=ev, ts=time.time(), **data), ensure_ascii=False) + "\n")


def short(text, n=200):
    text = " ".join(str(text).split())
    return text if len(text) <= n else text[:n - 1] + "…"


def fmt_dur(sec):
    sec = int(sec or 0)
    if sec < 60:
        return f"{sec}s"
    if sec < 3600:
        return f"{sec // 60}m{sec % 60:02d}s"
    return f"{sec // 3600}h{sec % 3600 // 60:02d}m"


def fmt_tokens(n):
    if not n:
        return "?"
    if n < 1000:
        return str(n)
    return f"{n / 1e6:.2f}M" if n >= 1e6 else f"{n / 1e3:.0f}k" if n >= 1e4 else f"{n / 1e3:.1f}k"


def fmt_time(ts):
    return time.strftime("%Y-%m-%d %H:%M", time.localtime(ts)) if ts else "?"


def plural(n, word):
    return f"{n} {word}" + ("" if n == 1 else "s")


class Flock:
    """An exclusive flock on a file, held for the with-block."""

    def __init__(self, path):
        self.path = path

    def __enter__(self):
        self.fd = os.open(self.path, os.O_RDWR | os.O_CREAT, 0o600)
        fcntl.flock(self.fd, fcntl.LOCK_EX)
        return self

    def __exit__(self, *exc):
        os.close(self.fd)


class Tail:
    """Reads the JSON lines appended to a file since the last call."""

    def __init__(self, path, pos=0):
        self.path, self.pos, self.buf = path, pos, b""

    def lines(self):
        try:
            with open(self.path, "rb") as f:
                f.seek(self.pos)
                data = f.read()
        except FileNotFoundError:
            return []
        self.pos += len(data)
        self.buf += data
        *done, self.buf = self.buf.split(b"\n")
        out = []
        for line in done:
            try:
                out.append(json.loads(line))
            except ValueError:
                pass
        return out


def file_size(path):
    try:
        return path.stat().st_size
    except OSError:
        return 0


def caller():
    if os.environ.get("CLAUDECODE"):
        return "claude"
    if any(k in os.environ for k in ("CODEX_THREAD_ID", "CODEX_SESSION_ID", "CODEX_CI", "CODEX_SANDBOX")):
        return "codex"
    if os.environ.get("PI_CODING_AGENT"):
        return "pi"
    return "shell"


def child_env():
    return {k: v for k, v in os.environ.items() if k not in PARENT_ENV}


def pi_bin(env=None):
    """Resolve the managed selector for this launch, never a saved release pin."""
    env = os.environ if env is None else env
    agent = Path(env.get("PI_CODING_AGENT_DIR") or HOME / ".pi" / "agent").expanduser()
    install = agent / "install"
    selector = install / "current-version"
    if install.exists():
        try:
            version = selector.read_text().strip()
            if not version or version in (".", "..") or "/" in version or "\\" in version:
                return None
            release = (install / "releases" / version).resolve()
            exe = release / "node_modules" / ".bin" / "pi"
            package = release / "node_modules" / "@earendil-works" / "pi-coding-agent" / "package.json"
            if not release.is_relative_to((install / "releases").resolve()) or read_json(package).get("version") != version or not exe.resolve().is_relative_to(release):
                return None
            return str(exe) if os.access(exe, os.X_OK) else None
        except (OSError, ValueError, AttributeError, RuntimeError):
            return None  # A broken selector must not silently launch an older override.
    exe = env.get("PI_TASK_PI") or shutil.which("pi", path=env.get("PATH")) or str(HOME / ".local" / "bin" / "pi")
    return exe if os.access(exe, os.X_OK) else None


def is_command(text):
    """True for a slash command such as /compact, false for a path such as /home/x."""
    return re.match(r"/[A-Za-z][\w:.-]*(\s|$)", text) is not None


def trusted(cwd):
    cwd = Path(cwd).resolve()
    return any(cwd == root or root in cwd.parents for root in TRUSTED_ROOTS)


def boot_time():
    """When the machine booted, as `uptime -s` prints it."""
    try:
        return subprocess.run(["uptime", "-s"], capture_output=True, text=True, check=True).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        return "an unknown time"


# ---------------------------------------------------------------- models and availability

class Unavailable(Exception):
    """No suitable model is served now."""


def pi_config():
    """(providers, settings) from pi's models.json and settings.json."""
    models = read_json(PI_AGENT_DIR / "models.json", {}) or {}
    settings = read_json(PI_AGENT_DIR / "settings.json", {}) or {}
    return models.get("providers") or {}, settings


def secret(value):
    """A models.json key or header value: $NAME or ${NAME}, !command, or the literal."""
    if not isinstance(value, str) or not value:
        return None
    m = re.fullmatch(r"\$\{?([A-Za-z_][A-Za-z0-9_]*)\}?", value)
    if m:
        return os.environ.get(m.group(1))
    if value.startswith("!"):
        try:
            out = subprocess.run(value[1:], shell=True, capture_output=True, text=True, timeout=PROBE_TIMEOUT)
            return out.stdout.strip() or None
        except (OSError, subprocess.TimeoutExpired):
            return None
    return value


def probe(prov, timeout):
    """(served model IDs, error) for one provider's /models endpoint."""
    import urllib.error
    import urllib.request
    base = (prov.get("baseUrl") or "").rstrip("/")
    if not base:
        return None, "no baseUrl"
    headers = {"Accept": "application/json"}
    key = secret(prov.get("apiKey"))
    if key:
        headers["Authorization"] = f"Bearer {key}"
    for k, v in (prov.get("headers") or {}).items():
        v = secret(v)
        if v is not None:
            headers[k] = v
    try:
        with urllib.request.urlopen(urllib.request.Request(base + "/models", headers=headers), timeout=timeout) as r:
            data = json.load(r)
    except urllib.error.HTTPError as e:
        return None, f"HTTP {e.code}"
    except (urllib.error.URLError, OSError, ValueError) as e:
        reason = getattr(e, "reason", None) or e
        return None, short(str(reason), 80)
    ids = [m.get("id") for m in (data.get("data") if isinstance(data, dict) else data) or []
           if isinstance(m, dict) and m.get("id")]
    return ids, None


def configured():
    """The providers with a baseUrl in models.json and their models, unprobed: (probes, settings)."""
    providers, settings = pi_config()
    out = []
    for name, prov in providers.items():
        if isinstance(prov, dict) and prov.get("baseUrl"):
            models = {m.get("id"): m for m in prov.get("models") or [] if isinstance(m, dict) and m.get("id")}
            out.append({"provider": name, "url": prov["baseUrl"], "error": None, "served": [],
                        "configured": models, "config": prov})
    return out, settings


def availability(timeout=None):
    """What each configured provider serves now, probed in parallel: (probes, settings)."""
    from concurrent.futures import ThreadPoolExecutor
    probes, settings = configured()
    timeout = PROBE_TIMEOUT if timeout is None else timeout
    with ThreadPoolExecutor(max_workers=max(1, len(probes))) as pool:
        results = list(pool.map(lambda p: probe(p["config"], timeout), probes))
    for p, (ids, err) in zip(probes, results):
        p["served"], p["error"] = ids or [], err
    return probes, settings


def model_levels(cfg):
    """The thinking levels pi offers for a model, lowest first, as pi-ai's
    getSupportedThinkingLevels decides: a level mapped to null is out, and xhigh and
    max are in only when mapped."""
    cfg = cfg or {}
    if not cfg.get("reasoning"):
        return ["off"]
    tmap = cfg.get("thinkingLevelMap") if isinstance(cfg.get("thinkingLevelMap"), dict) else {}
    levels = [lv for lv in LEVELS if not (lv in tmap and tmap[lv] is None)
              and (lv not in ("xhigh", "max") or tmap.get(lv) is not None)]
    return levels or ["off"]


def find_model(want, probes, settings):
    """(provider, id, cfg) of the configured model `want` names, or None. `want` may be
    provider/id, an ID, or a unique part of an ID; the default provider wins a tie."""
    if "/" in want:
        prov, mid = want.split("/", 1)
        for p in probes:
            if p["provider"] == prov and mid in p["configured"]:
                return prov, mid, p["configured"][mid]
        return None
    order = sorted(probes, key=lambda p: p["provider"] != settings.get("defaultProvider"))
    for test in (lambda m: m == want, lambda m: m.lower() == want.lower(), lambda m: want.lower() in m.lower()):
        hits = [(p["provider"], m, cfg) for p in order for m, cfg in p["configured"].items() if test(m)]
        ids = {m for _, m, _ in hits}
        if len(ids) == 1 or (hits and hits[0][1] == want):
            return hits[0]
        if len(ids) > 1:
            die(f"model {want!r} matches several: {', '.join(sorted(ids))}", 2)
    return None


def served(probes, prov, mid):
    return any(p["provider"] == prov and mid in p["served"] for p in probes)


def choose_model(want=None, timeout=None):
    """Pick the model a session runs: (provider, id, cfg, note). The requested model if served,
    else the preferred Qwen, pi's default, then another served Qwen. Raises Unavailable.
    Probe only the providers needed to establish that choice."""
    from concurrent.futures import ThreadPoolExecutor
    probes, settings = configured()
    if not probes:
        raise Unavailable(f"no provider with a baseUrl in {PI_AGENT_DIR / 'models.json'}")
    timeout = PROBE_TIMEOUT if timeout is None else timeout
    asked = find_model(want, probes, settings) if want else None
    if want and not asked:
        names = sorted(f"{p['provider']}/{m}" for p in probes for m in p["configured"])
        die(f"model {want!r} is not in {PI_AGENT_DIR / 'models.json'}; configured: {', '.join(names) or 'none'}", 2)
    dprov, did = settings.get("defaultProvider"), settings.get("defaultModel")
    default = find_model(f"{dprov}/{did}", probes, settings) if dprov and did else None

    def ask_providers(candidates):
        rest = [p for p in candidates if not p.get("probed")]
        with ThreadPoolExecutor(max_workers=max(1, len(rest))) as pool:
            for p, (ids, err) in zip(rest, pool.map(lambda p: probe(p["config"], timeout), rest)):
                p["served"], p["error"], p["probed"] = ids or [], err, True

    if asked:
        ask_providers([p for p in probes if p["provider"] == asked[0]])
        if served(probes, asked[0], asked[1]):
            return (*asked, None)
    missing = f"{asked[0]}/{asked[1]} is not served" if asked else None
    preferred = sorted([p for p in probes if PREFERRED_MODEL in p["configured"]],
                       key=lambda p: p["provider"] != dprov)
    ask_providers(preferred)
    for p in preferred:
        if PREFERRED_MODEL in p["served"]:
            note = f"{missing}; using {p['provider']}/{PREFERRED_MODEL}" if missing else None
            return p["provider"], PREFERRED_MODEL, p["configured"][PREFERRED_MODEL], note
    if not want and DEFAULT_MODEL:
        return choose_model(DEFAULT_MODEL, timeout)
    if default:
        ask_providers([p for p in probes if p["provider"] == default[0]])
    if default and default != asked and served(probes, default[0], default[1]):
        return (*default, f"{missing}; using pi's default {default[0]}/{default[1]}" if missing else None)
    ask_providers(probes)
    for p in sorted(probes, key=lambda p: p["provider"] != dprov):
        for mid in p["served"]:
            if mid in p["configured"] and "qwen" in mid.lower():
                why = missing or (f"pi's default {dprov}/{did} is not served" if default else "no model asked for")
                return p["provider"], mid, p["configured"][mid], f"{why}; using {p['provider']}/{mid}"
    states = "; ".join(f"{p['provider']} " + (f"unreachable ({p['error']})" if p["error"] else
                                              "serves " + (", ".join(p["served"]) or "nothing"))
                       for p in probes)
    hint = " (the Codex sandbox blocks the network)" if os.environ.get("CODEX_SANDBOX_NETWORK_DISABLED") else ""
    raise Unavailable(f"no Qwen model from models.json is served now{hint}: {states}. Use claude-task instead.")


def pick_model(want=None):
    """choose_model, or exit 4 with one line."""
    try:
        return choose_model(want)
    except Unavailable as e:
        die(str(e), EXIT_UNAVAILABLE)


def check_thinking(level, cfg, model):
    levels = model_levels(cfg)
    if level is None:
        return levels[-1]
    if level not in LEVELS:
        die(f"thinking must be one of: {', '.join(LEVELS)}", 2)
    if level not in levels:
        die(f"{model} maps only these thinking levels: {', '.join(levels)}", 2)
    return level


# ---------------------------------------------------------------- tmux and windows

def tmux_conf():
    """The config file for pi-task's tmux server, written when it differs; None when it cannot be."""
    path = STATE_DIR / "tmux.conf"
    if read_text(path) != TMUX_CONF:
        try:
            STATE_DIR.mkdir(parents=True, exist_ok=True)
            tmp = path.with_name(f".tmux.conf.{os.getpid()}.tmp")
            tmp.write_text(TMUX_CONF, encoding="utf-8")
            os.replace(tmp, path)
        except OSError:
            return None              # read-only, as in the Codex sandbox: only a new server needs it
    return path


def read_text(path):
    try:
        return path.read_text(encoding="utf-8")
    except OSError:
        return None


def tmux(*args, check=False):
    exe = shutil.which("tmux") or die("tmux is not installed")
    conf = tmux_conf()
    out = subprocess.run([exe, "-L", TMUX_SOCKET, *(["-f", str(conf)] if conf else []), *args], capture_output=True,
                         text=True, env=child_env(), stdin=subprocess.DEVNULL)
    if check and out.returncode:
        die(f"tmux {args[0]} failed: {out.stderr.strip() or out.stdout.strip()}")
    return out


def panes():
    """{tmux session: {"dead", "pid", "status"}} for every pi-task tmux session, or None when
    tmux runs but cannot be asked, as when a sandbox blocks its socket."""
    out = tmux("list-panes", "-a", "-F", "#{session_name}\t#{pane_dead}\t#{pane_pid}\t#{pane_dead_status}")
    if out.returncode:
        sock = Path(os.environ.get("TMUX_TMPDIR") or "/tmp") / f"tmux-{os.getuid()}" / TMUX_SOCKET
        gone = re.search(r"no server running|Connection refused|No such file", out.stderr)
        return None if sock.exists() and not gone else {}
    found = {}
    for line in out.stdout.splitlines():
        name, dead, pid, status = (line.split("\t") + ["", "", ""])[:4]
        found.setdefault(name, {"dead": dead == "1", "pid": int(pid) if pid.isdigit() else None,
                                "status": int(status) if status.lstrip("-").isdigit() else None})
    return found


def tmux_name(name):
    return name.replace(".", "_").replace(":", "_")


def desktop_env():
    """DISPLAY, WAYLAND_DISPLAY and the session bus of the user's desktop, from gnome-shell's environment."""
    for proc in Path("/proc").iterdir():
        try:
            if not proc.name.isdigit() or proc.stat().st_uid != os.getuid() \
                    or (proc / "comm").read_text().strip() != "gnome-shell":
                continue
            env = dict(kv.split("=", 1) for kv in (proc / "environ").read_bytes().decode(errors="replace").split("\0")
                       if "=" in kv)
        except OSError:
            continue
        return {k: env[k] for k in ("DISPLAY", "WAYLAND_DISPLAY", "DBUS_SESSION_BUS_ADDRESS") if env.get(k)}
    return {}


def display_env():
    """The environment for a window on the user's desktop, or None when there is none."""
    env = child_env()
    # The tab id of the terminal that started the caller. Once that tab closes, gnome-terminal
    # refuses every new window ("Failed to get screen from object path").
    env.pop("GNOME_TERMINAL_SCREEN", None)
    if not env.get("DISPLAY") and not env.get("WAYLAND_DISPLAY"):
        env.update(desktop_env())
    if not env.get("DISPLAY") and not env.get("WAYLAND_DISPLAY"):
        xs = sorted(Path("/tmp/.X11-unix").glob("X*"))
        if xs:
            env["DISPLAY"] = ":" + xs[0].name[1:]
    if not env.get("DBUS_SESSION_BUS_ADDRESS"):
        bus = Path(env.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}") / "bus"
        if bus.exists():
            env["DBUS_SESSION_BUS_ADDRESS"] = f"unix:path={bus}"
    if not env.get("DBUS_SESSION_BUS_ADDRESS") or not (env.get("DISPLAY") or env.get("WAYLAND_DISPLAY")):
        return None
    return env


def pid_alive(pid):
    if not pid:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    try:
        # A zombie has exited; its parent has not reaped it yet. tmux 3.4 leaves pi killed with
        # SIGKILL a zombie for seconds or more.
        return Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[0] not in ("Z", "X")
    except (OSError, IndexError):
        return True


# ---------------------------------------------------------------- sessions

ASK = object()   # "ask tmux", as the default of arguments that take what tmux said

class Session:
    def __init__(self, name):
        self.name = name
        self.dir = SESSIONS / name
        self.queue_dir = self.dir / "queue"
        self.sent_dir = self.dir / "sent"     # messages handed to pi that its conversation may not hold yet
        self.meta_path = self.dir / "meta.json"
        self.state_path = self.dir / "state.json"   # written by the extension
        self.log_path = self.dir / "log.jsonl"

    def meta(self):
        return read_json(self.meta_path, {})

    def state(self):
        return read_json(self.state_path, {})

    def lock(self):
        """Guards the queue and meta.json."""
        return Flock(self.dir / "queue.lock")

    def start_lock(self):
        """Held while a command restarts pi, queues an item and starts pi, so that two callers
        never both restart it, and a restart's stop never drops another caller's item."""
        return Flock(self.dir / "start.lock")

    @property
    def tmux(self):
        return self.meta().get("tmux") or tmux_name(self.name)

    def pane(self, all_panes=ASK):
        """The session's tmux pane, from `all_panes` (default: ask tmux). When tmux cannot be
        asked, pi's process from state.json stands in for it."""
        all_panes = panes() if all_panes is ASK else all_panes
        if all_panes is None:
            st = self.state()
            pid = st.get("pid")
            return {"dead": False, "pid": pid, "status": None} if pid and not st.get("stopped") and pid_alive(pid) \
                else None
        return all_panes.get(self.tmux)

    def alive(self, all_panes=ASK):
        """pi runs: its tmux pane lives. pi is the pane's process."""
        p = self.pane(all_panes)
        return bool(p and not p["dead"])

    def queued(self, folder=None):
        """(path, item) for each item in queue/, or in another folder of items such as sent/."""
        items = []
        for path in sorted((folder or self.queue_dir).glob("[0-9]*.json")):
            item = read_json(path)
            if item is not None:
                items.append((path, item))
        return items

    def messages_waiting(self):
        return [item for _, item in self.queued() if item["kind"] in ("message", "compact")]

    def enqueue(self, items, settings=None, only_if=None):
        """Queue items for the extension. Controls, interrupts and stops are skipped when pi
        does not run: new settings are in meta.json and apply when it starts. only_if, if
        given, is called under the lock; when it returns a false value, nothing is queued.
        Returns the sequence numbers of the queued items."""
        with self.lock():
            if only_if and not only_if():
                return []
            meta = self.meta()
            meta.update(settings or {})
            alive = self.alive()
            seqs = []
            for item in items:
                if item["kind"] not in ("message", "compact") and not alive:
                    continue
                seq = meta["next_seq"]
                meta["next_seq"] = seq + 1
                if item["kind"] in ("message", "compact"):
                    meta["last_msg"] = seq
                write_json(self.queue_dir / f"{seq:08d}.json", dict(item, seq=seq, ts=time.time()))
                seqs.append(seq)
            meta["updated"] = time.time()
            write_json(self.meta_path, meta)
        return seqs

    def launch(self, window=None, quiet=False):
        """Start pi in the session's tmux session unless it runs. Opens a window unless the
        session is hidden. Returns True if it started pi. When it starts pi for a queued message
        or compaction, the session's place in line for a Qwen slot is held while pi starts."""
        meta = self.meta()
        pane = self.pane()
        started = False
        if not pane or pane["dead"]:
            # Logged first, so the extension's start event always comes after it.
            append_log(self.log_path, "launch")
            env_file = self.dir / "env.json"
            fd = os.open(env_file, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                json.dump(child_env(), f)
            cmd = [sys.executable, os.path.realpath(__file__), "_exec", self.name]
            env = ["-e", f"PI_TASK_DIR={self.dir}", "-e", f"PI_TASK_NAME={self.name}"]
            if pane:
                tmux("respawn-pane", "-k", "-t", f"={self.tmux}:", "-c", meta["cwd"], *env, "--", *cmd, check=True)
            else:
                tmux("new-session", "-d", "-s", self.tmux, "-x", "200", "-y", "50", "-c", meta["cwd"], *env,
                     "--", *cmd, check=True)
            # The item pi will start with, in the extension's order: recover's note first, then by seq.
            first = min((item for _, item in self.queued() if item["kind"] in ("message", "compact")),
                        key=lambda item: (not item.get("first"), item["seq"]), default=None)
            if first:
                slot_reserve(self.name, first.get("ts") or time.time())
            tmux("set-option", "-t", f"={self.tmux}", "@pitask_name", self.name)
            with self.lock():
                meta = self.meta()
                meta["launched"] = time.time()
                write_json(self.meta_path, meta)
            started = True
        if window if window is not None else (started and not meta.get("hidden")):
            self.open_window(quiet)
        return started

    def clients(self):
        out = tmux("list-clients", "-t", f"={self.tmux}", "-F", "#{client_pid}")
        return [int(p) for p in out.stdout.split() if p.isdigit()] if out.returncode == 0 else []

    def open_window(self, quiet=False):
        """Open a gnome-terminal window attached to the session. Returns its client pid or None."""
        term = shutil.which("gnome-terminal")
        if not term:
            say(f"{self.name}: no window: gnome-terminal is not installed; `{PROG} attach {self.name}` "
                f"shows the session in a terminal", quiet)
            return None
        env = display_env()
        if env is None:
            say(f"{self.name}: no window: no display or session bus here; `{PROG} show {self.name}` "
                f"opens one from the desktop", quiet)
            return None
        tmux_exe = shutil.which("tmux")
        err = self.dir / "window.log"
        before = set(self.clients())
        with open(err, "ab") as errf:
            proc = subprocess.Popen([term, "--wait", f"--title=pi-task: {self.name}", "--", tmux_exe, "-L",
                                     TMUX_SOCKET, "attach-session", "-t", f"={self.tmux}"],
                                    env=env, stdin=subprocess.DEVNULL, stdout=errf, stderr=errf,
                                    start_new_session=True)
        deadline = time.time() + 10
        while time.time() < deadline:
            if set(self.clients()) - before:
                break
            if proc.poll() is not None:
                say(f"{self.name}: the window did not open (gnome-terminal exited {proc.returncode}): "
                    f"{short(read_text(err) or '', 300)}")
                return None
            time.sleep(0.1)
        with self.lock():
            meta = self.meta()
            meta["window_pid"] = proc.pid
            write_json(self.meta_path, meta)
        return proc.pid

    def close_windows(self):
        """Detach every client: their windows close, the session keeps running."""
        if self.clients():
            tmux("detach-client", "-s", f"={self.tmux}")
            return True
        return False

    def screen(self):
        """What pi's pane shows now."""
        out = tmux("capture-pane", "-p", "-t", f"={self.tmux}:")
        return out.stdout if out.returncode == 0 else ""

    def pane_tail(self, n=12):
        out = tmux("capture-pane", "-p", "-t", f"={self.tmux}:", "-S", f"-{n * 3}")
        lines = [line.rstrip() for line in out.stdout.splitlines() if line.strip()] if out.returncode == 0 else []
        return "\n".join(lines[-n:])


def all_sessions():
    if not SESSIONS.is_dir():
        return []
    return [Session(d.name) for d in sorted(SESSIONS.iterdir()) if (d / "meta.json").exists()]


def resolve(ref):
    sessions = all_sessions()
    if not sessions:
        die("there are no sessions yet")
    if ref == "last":
        return max(sessions, key=last_active)
    names = {s.name: s for s in sessions}
    if ref in names:
        return names[ref]
    hits = [s for s in sessions if s.name.startswith(ref)]
    if not hits:
        hits = [s for s in sessions if (s.meta().get("pi_session_id") or "").startswith(ref)]
    if len(hits) == 1:
        return hits[0]
    if hits:
        die(f"{ref!r} matches several sessions: {', '.join(s.name for s in hits)}")
    die(f"no session matches {ref!r}; see `{PROG} list`")


def last_active(sess):
    return max(sess.meta().get("updated") or 0, sess.state().get("updated") or 0)


def interruption(sess, st=None, alive=None):
    """What a crash or reboot cut in this session, or None.

    pi that ends normally records a clean shutdown, and `stop` drops what was queued."""
    st = sess.state() if st is None else st
    if sess.alive() if alive is None else alive:
        return None
    meta = sess.meta()
    if time.time() - (meta.get("launched") or 0) < START_GRACE and (meta.get("launched") or 0) > (st.get("updated") or 0):
        return None                  # launched a moment ago: pi is starting
    queued = sess.messages_waiting()
    since = st.get("updated") or 0
    if any(item.get("ts", 0) > since and time.time() - item.get("ts", 0) < START_GRACE for item in queued):
        return None                  # queued since pi last ran, a moment ago: a start is on its way
    cut = []
    # pi that shut down saved what it cut; pi that died left its live state behind.
    was = st.get("cut") or (st if (st.get("busy") or st.get("compacting")) and not st.get("stopped") else {})
    if was.get("compacting"):
        cut.append("cut while compacting")
    elif was.get("busy") or was.get("turn"):
        cut.append("cut mid-run")
    sent = len(sess.queued(sess.sent_dir))
    if sent:
        cut.append(plural(sent, "message") + " to send again")
    if queued:
        cut.append(plural(len(queued), "queued message"))
    return ", ".join(cut) or None


def describe_state(sess, st=None, alive=None, all_panes=ASK):
    all_panes = panes() if all_panes is ASK else all_panes
    st = sess.state() if st is None else st
    alive = sess.alive(all_panes) if alive is None else alive
    queued = bool(sess.messages_waiting())
    if not alive:
        if interruption(sess, st, alive):
            return "interrupted"
        if queued:
            return "starting"
        return "stopped"
    pane = sess.pane(all_panes)
    if not st.get("pid") or (pane and st.get("pid") != pane["pid"]) or st.get("stopped"):
        return "starting"
    if st.get("compacting"):
        return "compacting"
    if st.get("busy") or st.get("starting") or st.get("pending"):
        return "working"
    if queued and st.get("waiting"):
        return "waiting"
    if queued:
        return "working"
    return "error" if st.get("error") else "idle"


# ---------------------------------------------------------------- the cap on sessions in use

def model_id(model):
    """Caps follow model IDs, shared across providers. None is the unknown-model pool."""
    return model if isinstance(model, str) and model else None


def read_model_caps():
    """Explicit overrides; keep max-active as the default for every other model."""
    path = CAP_FILE.with_name(MODEL_CAPS_NAME)
    data = read_json(path)
    if data is None and not path.exists():
        return {}, None
    if not isinstance(data, dict) or any(not isinstance(k, str) or not k or
                                        type(v) is not int or v < 1 for k, v in data.items()):
        return {}, f"{path} holds invalid model caps; using the default cap"
    return data, None


def read_cap(model=None):
    """(cap, problem): the most sessions in use at once, from CAP_FILE. DEFAULT_CAP when the file
    is missing, or does not hold a whole number from 1 up; problem then says so."""
    caps, problem = read_model_caps()
    if model_id(model) in caps:
        return caps[model_id(model)], problem
    text = read_text(CAP_FILE)
    if text is None:
        return DEFAULT_CAP, problem
    try:
        cap = int(text.strip())
    except ValueError:
        cap = 0
    if cap < 1:
        return DEFAULT_CAP, f"{CAP_FILE} holds {short(text, 20)!r}, not a whole number from 1 up; using {DEFAULT_CAP}"
    return cap, problem


def runs_pi(sess_dir, pid):
    """True if process `pid` lives and is the pi that pi-task started for the session in
    `sess_dir`: its environment names that folder in PI_TASK_DIR. A reused pid fails the test."""
    if not pid_alive(pid):
        return False
    try:
        env = Path(f"/proc/{pid}/environ").read_bytes()
    except OSError:
        return False             # gone meanwhile, or another user's process
    for var in env.split(b"\0"):
        if var.startswith(b"PI_TASK_DIR="):
            value = os.fsdecode(var[len(b"PI_TASK_DIR="):])
            return value == str(sess_dir) or os.path.realpath(value) == os.path.realpath(sess_dir)
    return False


def session_busy(st):
    """The extension's snapshot says a run or a compaction is on, or a run is about to start."""
    return bool(st.get("busy") or st.get("compacting") or st.get("starting") or st.get("pending"))


def slots_read():
    """The slot table: gen, holders {name: {pid, since, why}} and waiters {name: {pid, since, seen}}.
    A holder's since is when it got its slot, a waiter's since when its item was queued."""
    data = read_json(SLOTS_FILE, {})
    data = data if isinstance(data, dict) else {}
    return {"gen": int(data.get("gen") or 0), "holders": dict(data.get("holders") or {}),
            "waiters": dict(data.get("waiters") or {})}


def process_start(pid):
    """Linux process identity, including zombies (which still pin their PID)."""
    try:
        return Path(f"/proc/{int(pid)}/stat").read_text().rsplit(")", 1)[1].split()[19]
    except (OSError, ValueError, TypeError, IndexError):
        return None


def external_alive(entry):
    return bool(entry.get("start") and process_start(entry.get("pid")) == entry["start"]
                and pid_alive(entry.get("pid")))


def slots_prune(table, now):
    """Drop the holders whose pi is gone or whose extension says it holds no slot (a release that
    got lost), and the waiters whose pi is gone or that stopped asking. External leases use
    their guardian's PID/start identity instead of session state. True if any went."""
    gone = False
    for name, h in list(table["holders"].items()):
        if name.startswith(EXTERNAL_SLOT):
            if not external_alive(h):
                del table["holders"][name]
                gone = True
            continue
        folder = SESSIONS / name
        st = read_json(folder / "state.json", {}) or {}
        lost = (st.get("pid") == h.get("pid") and (st.get("ext") or 0) >= EXT_PROTOCOL and not st.get("slot")
                and (st.get("updated") or 0) > (h.get("since") or 0) + 1)
        if lost or not runs_pi(folder, h.get("pid")):
            del table["holders"][name]
            gone = True
    for name, w in list(table["waiters"].items()):
        dead = (not external_alive(w) if name.startswith(EXTERNAL_SLOT) else
                w.get("pid") is not None and not runs_pi(SESSIONS / name, w.get("pid")))
        if now - (w.get("seen") or 0) > WAITER_STALE or dead:
            del table["waiters"][name]
            gone = True
    return gone


def slot_model(name, entry=None):
    """Actual live model first, then metadata or the entry's saved model. Old entries need
    no migration, and pending/failed model controls must not override a live pi's model."""
    if name.startswith(EXTERNAL_SLOT):
        return model_id((entry or {}).get("model"))
    folder = SESSIONS / name
    st = read_json(folder / "state.json", {}) or {}
    if st.get("model") and not st.get("stopped") and (
            not entry or entry.get("pid") is None or entry.get("pid") == st.get("pid")) and runs_pi(folder, st.get("pid")):
        return model_id(st["model"])
    meta = read_json(folder / "meta.json", {}) or {}
    return model_id(meta.get("model")) or model_id((entry or {}).get("model"))


def slot_users(table, model=ALL_MODELS):
    """{name: what} for each session in use: the slot holders ("run" or "compact"), and the
    sessions whose live pi works or compacts without a slot ("working" or "compacting"), as when
    the user typed in its window or its extension predates the cap."""
    users = {name: h.get("why") or "run" for name, h in table["holders"].items()}
    try:
        folders = list(SESSIONS.iterdir())
    except OSError:
        folders = []
    for folder in folders:
        if folder.name in users:
            continue
        st = read_json(folder / "state.json")
        if isinstance(st, dict) and not st.get("stopped") and session_busy(st) and runs_pi(folder, st.get("pid")):
            users[folder.name] = "compacting" if st.get("compacting") else "working"
    if model is ALL_MODELS:
        return users
    return {n: why for n, why in users.items() if slot_model(n, table["holders"].get(n)) == model}


def slots_line(table, model=ALL_MODELS):
    """FIFO within each model; filtering never changes another caller's entry or timestamp."""
    return [name for name, w in sorted(table["waiters"].items(), key=lambda kv: (kv[1].get("since") or 0, kv[0]))
            if model is ALL_MODELS or slot_model(name, w) == model]


def slot_ask(name, pid, since, why, *, lease=None):
    """The extension of session `name`, pi `pid`, asks for a slot to start a run or a compaction
    (`why`) for an item queued at `since`. It gets one when fewer than the cap are in use and no
    waiter queued earlier is owed one of the free slots; else it keeps its place in line.
    External guardians pass immutable start/model/label metadata in `lease`."""
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with Flock(SLOTS_LOCK):
        now = time.time()
        table = slots_read()
        changed = slots_prune(table, now)
        held = table["holders"].get(name)
        model = slot_model(name, lease or held or table["waiters"].get(name))
        cap, _ = read_cap(model)
        users = slot_users(table, model)
        position = None
        if held and held.get("pid") == pid:
            granted = True
            if held.get("model") != model:
                held["model"] = model
                changed = True
        else:
            users.pop(name, None)
            w = table["waiters"].get(name)
            if not w or w.get("pid") != pid or w.get("since") != since:
                changed = changed or w is not None      # it leaves its old place in line
                w = table["waiters"][name] = {"pid": pid, "since": since, "model": model, **(lease or {})}
            if w.get("model") != model:
                w["model"] = model
                changed = True
            w["seen"] = now
            position = slots_line(table, model).index(name)
            granted = position < cap - len(users)
            if granted:
                del table["waiters"][name]
                table["holders"][name] = {"pid": pid, "since": now, "why": why, "queued": since,
                                           "model": model, **(lease or {})}
                users[name] = why
                changed = True
        if changed:
            table["gen"] += 1
        write_json(SLOTS_FILE, table)
    return {"granted": granted, "position": position, "in_use": len(users), "cap": cap, "gen": table["gen"], "model": model}


def slot_reserve(name, since):
    """pi-task has just started the pi of session `name` for an item queued at `since`: hold the
    session's place in line until its extension asks, so that a session queued later whose pi
    starts sooner does not pass it. A place no extension takes goes after WAITER_STALE."""
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with Flock(SLOTS_LOCK):
        now = time.time()
        table = slots_read()
        changed = slots_prune(table, now)
        if name not in table["holders"] and name not in table["waiters"]:
            table["waiters"][name] = {"pid": None, "since": since, "seen": now, "model": slot_model(name)}
            changed = True
        if changed:
            table["gen"] += 1
            write_json(SLOTS_FILE, table)


def slot_leave(name, pid, *, start=None):
    """The extension of session `name`, pi `pid`, gives up its slot or its place in line."""
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with Flock(SLOTS_LOCK):
        table = slots_read()
        changed = slots_prune(table, time.time())
        left = []
        for part in ("holders", "waiters"):
            entry = table[part].get(name)
            if entry and entry.get("pid") == pid and (not name.startswith(EXTERNAL_SLOT) or
                                                       entry.get("start") == start):
                del table[part][name]
                left.append(part)
        if changed or left:
            table["gen"] += 1
            write_json(SLOTS_FILE, table)
    return {"left": left, "gen": table["gen"]}


def slot_view(model=ALL_MODELS):
    """(cap, problem, users, line, table) as they stand, pruned but not written back: what cap,
    list and status show."""
    table = slots_read()
    slots_prune(table, time.time())
    cap, problem = read_cap(None if model is ALL_MODELS else model)
    return cap, problem, slot_users(table, model), slots_line(table, model), table


def ordinal(n):
    return f"{n}" + ("th" if 10 <= n % 100 <= 20 else {1: "st", 2: "nd", 3: "rd"}.get(n % 10, "th"))


def waiting_note(name, users, line, cap):
    """'K of CAP in use, Nth in line' for a waiting session."""
    note = f"{len(users)} of {cap} in use"
    return note + (f", {ordinal(line.index(name) + 1)} in line" if name in line else "")


def old_extension(sess, st=None):
    """True if the session's live pi runs an extension that predates the cap, which starts runs
    without a slot."""
    st = sess.state() if st is None else st
    return not st.get("stopped") and (st.get("ext") or 0) < EXT_PROTOCOL and runs_pi(sess.dir, st.get("pid"))


def renew(sess, quiet=False):
    """Before a message or a compaction that may start a run: when the session's pi runs idle
    with an extension that predates the cap, stop it as `stop` does and keep its tmux pane, so
    the next launch starts it again on the same conversation with the current extension, and
    its window stays. True if it stopped pi. A pi at work keeps running: what is sent to it goes
    in as a steer or follow-up."""
    pane = sess.pane()
    if not pane or pane["dead"]:
        return False
    st = sess.state()
    if st.get("pid") != pane["pid"] or st.get("stopped") or (st.get("ext") or 0) >= EXT_PROTOCOL:
        return False             # pi is starting, with the current extension, or runs it
    if session_busy(st) or sess.messages_waiting():
        return False
    [seq] = sess.enqueue([{"kind": "stop"}])
    deadline = time.time() + RENEW_TIMEOUT
    while time.time() < deadline and sess.alive():
        time.sleep(TICK)
    if sess.alive():
        with sess.lock():            # a stop left behind would end the next pi at its start
            (sess.queue_dir / f"{seq:08d}.json").unlink(missing_ok=True)
        die(f"{sess.name}: its pi runs a pi-task extension from before the cap on sessions in use, and did "
            f"not quit within {RENEW_TIMEOUT:g} s to be restarted with the current one; see `{PROG} show {sess.name}`")
    append_log(sess.log_path, "renew", ext=st.get("ext") or 1)
    say(f"{sess.name}: restarting pi, whose pi-task extension predates the cap on sessions in use", quiet)
    return True


def cmd_slot(argv):
    """`pi-task _slot ask NAME PID SINCE WHY` and `pi-task _slot leave NAME PID`: the
    extension's side of the cap. Prints the answer as one line of JSON."""
    try:
        op, name, pid = argv[0], argv[1], int(argv[2])
        args = (float(argv[3]), argv[4]) if op == "ask" else ()
        if op not in ("ask", "leave") or not NAME_RE.fullmatch(name):
            raise ValueError(op)
    except (IndexError, ValueError):
        die("usage: pi-task _slot ask NAME PID SINCE WHY | _slot leave NAME PID", 2)
    out = slot_ask(name, pid, *args) if op == "ask" else slot_leave(name, pid)
    print(json.dumps(out), flush=True)
    return 0


def external_guard(a, control):
    """Own the lease independently of the public wrapper. EOF means its parent died.
    A Linux subreaper also catches orphaned/detached descendants during cleanup."""
    import ctypes
    import select
    import secrets

    os.setsid()                 # terminal signals go through the public wrapper
    libc = ctypes.CDLL(None, use_errno=True)
    if libc.prctl(36, 1, 0, 0, 0) != 0:  # PR_SET_CHILD_SUBREAPER
        raise OSError(ctypes.get_errno(), "cannot become a command subreaper")
    children = Path(f"/proc/self/task/{os.getpid()}/children")
    children.read_text()        # fail before launching if owned children cannot be inspected
    cancelled = 0

    def cancel(sig, frame):
        nonlocal cancelled
        cancelled = cancelled or sig

    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP, signal.SIGQUIT):
        signal.signal(sig, cancel)
    signal.signal(signal.SIGPIPE, signal.SIG_IGN)

    def check_parent(delay=0):
        nonlocal cancelled
        if select.select([control], [], [], delay)[0]:
            data = os.read(control, 1)
            cancelled = cancelled or (data[0] if data else signal.SIGTERM)

    def reap():
        """Reap all exited descendants; say whether any children still live."""
        while True:
            try:
                pid, status = os.waitpid(-1, os.WNOHANG)
            except ChildProcessError:
                return False
            if not pid:
                return True
            if child is not None and pid == child.pid:
                child.returncode = os.waitstatus_to_exitcode(status)

    def terminate(sig):
        # These unreaped direct children pin their PIDs. Killing their parents
        # adopts deeper descendants here, even if they called setsid/setpgid.
        # Do not killpg a reaped leader's ID: that ID could already be reused.
        for pid in children.read_text().split():
            try:
                os.kill(int(pid), sig)
            except ProcessLookupError:
                pass

    name = EXTERNAL_SLOT + secrets.token_hex(32)
    pid, since = os.getpid(), time.time()
    lease = {"start": process_start(pid), "model": a.model, "label": a.name}
    if lease["start"] is None:
        raise OSError("cannot read guardian process identity")
    child = None
    try:
        noted = False
        while True:
            check_parent()
            if cancelled:
                return 128 + cancelled
            info = slot_ask(name, pid, since, "external", lease=lease)
            if info["granted"]:
                break
            if not noted:
                print(f"{short(a.name, 64)}: waiting for a Qwen slot ({info['in_use']} of {info['cap']} in use, "
                      f"{ordinal(info['position'] + 1)} in line)", file=sys.stderr, flush=True)
                noted = True
            check_parent(TICK)
        check_parent()
        if cancelled:
            return 128 + cancelled
        try:
            child = subprocess.Popen(a.command, start_new_session=True)
        except OSError as e:
            print(f"{PROG}: {a.command[0]}: {e.strerror}", file=sys.stderr)
            return 127 if e.errno == errno.ENOENT else 126
        deadline = None
        while True:
            check_parent(TICK)
            alive = reap()
            if cancelled or child.returncode is not None:
                if deadline is None:
                    terminate(cancelled or signal.SIGTERM)
                    deadline = time.monotonic() + 1
                elif time.monotonic() >= deadline:
                    terminate(signal.SIGKILL)
                if not alive:
                    rc = child.returncode
                    return 128 + cancelled if cancelled else (rc if rc >= 0 else 128 - rc)
    finally:
        # Never release while a command/descendant still lives, including on an
        # exception. The guardian outlives a killed public wrapper until done.
        if child is not None:
            while reap():
                terminate(signal.SIGKILL)
                time.sleep(0.02)
        slot_leave(name, pid, start=lease["start"])


def cmd_with_slot(a):
    if not a.model.strip() or not a.name.strip() or not a.command or a.command[0] != "--" or len(a.command) < 2:
        die("usage: pi-task with-slot --model MODEL --name LABEL -- COMMAND [ARG...]", 2)
    a.command = a.command[1:]
    control, notify = os.pipe2(os.O_CLOEXEC | os.O_NONBLOCK)
    caught = 0

    def forward(sig, frame):
        nonlocal caught
        if not caught:
            caught = sig
            os.write(notify, bytes([sig]))

    handlers = {sig: signal.signal(sig, forward) for sig in
                (signal.SIGINT, signal.SIGTERM, signal.SIGHUP, signal.SIGQUIT)}
    try:
        guardian = os.fork()
        if guardian == 0:
            os.close(notify)
            try:
                rc = external_guard(a, control)
            except BaseException as e:
                print(f"{PROG}: with-slot: {e}", file=sys.stderr, flush=True)
                rc = 1
            os._exit(rc)
        os.close(control)
        _, status = os.waitpid(guardian, 0)
        return os.waitstatus_to_exitcode(status) if os.WIFEXITED(status) else 128 + os.WTERMSIG(status)
    finally:
        os.close(notify)
        for sig, handler in handlers.items():
            signal.signal(sig, handler)


# ---------------------------------------------------------------- waiting

class Outcome:
    def __init__(self):
        self.status = "waiting"      # done | error | timeout | interrupted
        self.error = None
        self.read = False
        self.sent = False            # pi took the item: sent to it, or compacting for it
        self.replies = []            # assistant events since the message was read
        self.compacts = []
        self.ctx = None
        self.aborted = False
        self.stop = None             # the requested run's idle stop reason, not a newer state snapshot


def scan(records, seq, out, compact=False):
    """Feed log records to `out`. True once the reply to item `seq` is complete."""
    for r in records:
        ev = r.get("ev")
        if r.get("ctx") is not None:
            out.ctx = r["ctx"]
        if ev == "compacted":
            out.ctx = r.get("post")      # None until the next answer reports the context again
        if ev in ("dropped", "failed") and seq in (r.get("seqs") or []):
            out.status, out.error = "error", r.get("error") or r.get("reason") or ev
            if r.get("reason"):
                out.error = f"the message was dropped: pi-task {r['reason']} the session before pi read it"
            return True
        if ev in ("sent", "compacting") and r.get("seq") == seq:
            out.sent = True
        if compact:
            if ev in ("compacted", "compact_failed") and r.get("seq") == seq:
                if ev == "compacted":
                    out.compacts.append(r)
                    out.status = "done"
                else:
                    error = r.get("error") or "unknown error"
                    out.status = "error"
                    out.error = error if error.lower().startswith("compaction") else f"compaction failed: {error}"
                return True
        elif ev == "read" and r.get("seq") == seq:
            out.read, out.replies, out.compacts = True, [], []
        elif out.read:
            if ev == "assistant":
                out.replies.append(r)
            elif ev == "compacted":
                out.compacts.append(r)
            elif ev == "idle":
                out.status, out.aborted = "done", bool(r.get("aborted"))
                out.stop = r.get("stop")
                return True
        if ev == "shutdown" and (out.read or out.sent):
            out.status = "error"
            out.error = ("pi-task stop ended the session" if r.get("stopping") else
                         f"pi exited before it finished; `{PROG} recover` resumes it")
            return True
    return False


def tree_cpu(pid):
    """CPU seconds used by process `pid` and its descendants, reaped children included."""
    children, used = {}, {}
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        try:
            with open(f"/proc/{entry}/stat", encoding="ascii", errors="replace") as f:
                fields = f.read().rsplit(")", 1)[1].split()
        except (OSError, IndexError):
            continue
        children.setdefault(int(fields[1]), []).append(int(entry))
        used[int(entry)] = sum(int(x) for x in fields[11:15])   # utime, stime, cutime, cstime
    total, todo = 0, [pid]
    while todo:
        p = todo.pop()
        total += used.get(p, 0)
        todo += children.get(p, [])
    return total / os.sysconf("SC_CLK_TCK")


class StartWatch:
    """Tells a slow start of pi from a stuck one, for a waiter.

    pi-task logs "launch" before it starts pi, and every later event comes from the
    extension, so the extension has started once any event follows the last launch. Until
    then pi counts as progressing while its processes use CPU, its screen changes or the
    log grows. Only a pi that shows none of these for EXT_START_TIMEOUT counts as stuck."""

    def __init__(self):
        self.started = True          # until a launch record says otherwise
        self.moved = time.time()     # when pi last showed progress
        self.cpu = self.screen = None

    def feed(self, records):
        for r in records:
            self.started = r.get("ev") != "launch"
            self.moved = time.time()

    def stalled(self, sess, pid):
        """Seconds pi has shown no progress while its extension has not started; 0 once it has."""
        if self.started:
            self.cpu = self.screen = None
            return 0
        now = time.time()
        cpu, screen = tree_cpu(pid) if pid else 0, sess.screen()
        if self.cpu is None or cpu - self.cpu >= CPU_STEP or screen != self.screen:
            self.moved = now
        self.cpu, self.screen = cpu, screen
        return now - self.moved


def wait_for(sess, seq, timeout=None, verbose=False, compact=False, quiet=False, cancel_event=None):
    """Wait until pi has read item `seq` and the session has settled. Says on stderr when the
    session waits for a Qwen slot and when it gets one, unless quiet. cancel_event stops only
    this observer, returning its partial Outcome after a final scan; it never controls pi."""
    out = Outcome()
    log = Tail(sess.log_path)
    watch = StartWatch()
    started = time.time()
    deadline = started + timeout if timeout else None
    check_at = started + 2
    seen = 0
    try:
        while True:
            records = log.lines()
            watch.feed(records)
            for r in records:
                line = render_event(r) if r.get("ts", 0) >= started - 1 else None
                if line and verbose:
                    print(line, file=sys.stderr, flush=True)
                elif line and r.get("ev") in ("waiting", "slot"):
                    say(f"{sess.name}: {line[3:]}", quiet)
            if scan(records, seq, out, compact):
                return out
            if cancel_event is not None and cancel_event.is_set():
                return out
            now = time.time()
            if deadline and now >= deadline:
                out.status = "timeout"
                return out
            if now >= check_at:
                check_at = now + 2
                pane = sess.pane()
                if not pane or pane["dead"]:
                    if scan(log.lines(), seq, out, compact):
                        return out
                    seen += 1
                    if seen < 2:
                        continue     # pi may be starting or restarting: look once more
                    out.status = "error"
                    cut = interruption(sess)
                    pane = sess.pane()
                    if cut:
                        out.error = f"a crash or reboot cut the session ({cut}); `{PROG} recover` resumes it"
                    elif pane and pane["dead"]:
                        out.error = f"pi exited (status {pane['status']}):\n{sess.pane_tail()}"
                    else:
                        out.error = f"pi stopped before it answered; see `{PROG} log {sess.name}`"
                    return out
                seen = 0
                still = watch.stalled(sess, pane["pid"])
                if still > EXT_START_TIMEOUT:
                    out.status = "error"
                    out.error = (f"pi runs, but the pi-task extension has not started, and pi has shown no "
                                 f"progress for {fmt_dur(still)}; see `{PROG} show {sess.name}`:\n{sess.pane_tail()}")
                    return out
            if cancel_event is None:
                time.sleep(TICK)
            else:
                cancel_event.wait(TICK)
    except KeyboardInterrupt:
        out.status = "interrupted"
        return out


def render_event(r):
    ev = r.get("ev")
    if ev == "tool":
        return f"  {r.get('name')}: {short(r.get('summary') or '', 160)}"
    if ev == "assistant" and (r.get("text") or "").strip():
        return f"qwen> {short(r['text'], 300)}"
    if ev == "assistant" and r.get("stop") == "error":
        return f"-- error: {short(r.get('error') or '', 300)}"
    if ev == "compacted":
        return f"-- compacted ({r.get('reason')}): {fmt_tokens(r.get('pre'))} tokens summarized"
    if ev == "idle":
        return "-- run ended" + (" (interrupted)" if r.get("aborted") else "")
    if ev == "waiting":
        place = f", {ordinal(r['position'] + 1)} in line" if isinstance(r.get("position"), int) else ""
        return f"-- waiting for a Qwen slot ({r.get('in_use')} of {r.get('cap')} in use{place})"
    if ev == "slot" and (r.get("waited") or 0) >= 1:
        return f"-- got a Qwen slot after {fmt_dur(r['waited'])}"
    return None


def reply_text(out):
    texts = [r["text"].strip() for r in out.replies if (r.get("text") or "").strip()]
    return texts[-1] if texts else ""


def stop_reason(out, st):
    """The last assistant message's stop reason, from the log or from state.json."""
    last = out.replies[-1] if out.replies else None
    return (last.get("stop") if last else None) or st.get("last_stop") or None


def no_answer(name, stop):
    """The stderr line for a run that ended with no answer text."""
    why = (f"; the output limit was reached (stop reason {stop})" if stop in ("length", "max_tokens")
           else (f" (stop reason {stop})" if stop else ""))
    return (f"{name}: Qwen gave no answer{why}; "
            f"try {PROG} send {name} -e medium '...' or a smaller task")


def report(sess, out, a, started, new=False, compact=False):
    """Print the answer to stdout and a status line to stderr. Returns the exit status."""
    quiet = getattr(a, "quiet", False)
    last = out.replies[-1] if out.replies else None
    failed = bool(last and last.get("stop") == "error" and not out.aborted)
    text = reply_text(out)
    st, m = sess.state(), sess.meta()
    empty = (out.status == "done" and not out.aborted and not failed and not text and not compact)
    if a.json:
        error = out.error or ("interrupted" if out.aborted else (last.get("error") if failed else None))
        data = {
            "session": sess.name, "status": out.status if not (out.aborted or failed) else "error",
            "error": error, "reply": text,
            "model": f"{st.get('provider') or m.get('provider')}/{st.get('model') or m.get('model')}",
            "thinking": st.get("thinking") or m.get("thinking"),
            "compactions": [{"reason": c.get("reason"), "pre": c.get("pre"), "post": c.get("post")}
                            for c in out.compacts],
            "context_tokens": out.ctx, "pi_session_file": st.get("session_file")}
        if empty:
            data["answer_empty"] = True
            data["stop_reason"] = stop_reason(out, st)
        print(json.dumps(data, ensure_ascii=False, indent=1), flush=True)
    else:
        if text:
            print(text, flush=True)
        for c in out.compacts:
            line = (f"Compacted: {fmt_tokens(c.get('pre'))} -> {fmt_tokens(c.get('post'))} tokens." if c.get("post")
                    else f"Compacted: {fmt_tokens(c.get('pre'))} tokens summarized.")
            if compact:
                print(line, flush=True)
            else:
                say(line, quiet)
    took = fmt_dur(time.time() - started)
    if out.status == "done":
        if empty:
            say(no_answer(sess.name, stop_reason(out, st)))
            return 1
        if out.aborted:
            bits = [f"{sess.name} interrupted after {took}"]
        elif failed:
            bits = [f"{sess.name} error after {took}: {short(last.get('error') or '', 300)}"]
        else:
            bits = [f"{sess.name} done after {took}"]
        if out.ctx:
            bits.append(f"context {fmt_tokens(out.ctx)} tokens")
        bits.append(f"{st.get('model') or m.get('model')}/{st.get('thinking') or m.get('thinking')}")
        if new:
            bits.append(f'follow up: {PROG} send {sess.name} "..."')
        say(" · ".join(bits), quiet and not (failed or out.aborted))
        return 1 if (failed or out.aborted) else 0
    if out.status == "error":
        say(f"{sess.name} error: {out.error}")
        return 1
    state = describe_state(sess)
    if state == "waiting":
        cap, _, users, line, _ = slot_view(slot_model(sess.name))
        state = f"waiting for a Qwen slot: {waiting_note(sess.name, users, line, cap)}"
    say(f"{sess.name} is still working after {took} ({state}). "
        f"Wait again: {PROG} wait {sess.name}", quiet and out.status != "interrupted")
    return 130 if out.status == "interrupted" else 3


def wait_controls(sess, seqs, timeout):
    """Collect the extension's answers to queued controls: {seq: record}."""
    want, got = set(seqs), {}
    log = Tail(sess.log_path)
    deadline = time.time() + timeout
    while want - set(got) and time.time() < deadline:
        for r in log.lines():
            if r.get("ev") == "control" and r.get("seq") in want:
                got[r["seq"]] = r
        time.sleep(0.2)
    return got


