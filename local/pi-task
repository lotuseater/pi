WRITE_BLOCKED = (errno.EROFS, errno.EACCES, errno.EPERM)


def preflight():
    """Stop early where pi-task cannot work: no write access to its state."""
    probe_file = STATE_DIR / f".probe-{os.getpid()}"
    try:
        SESSIONS.mkdir(parents=True, exist_ok=True)
        os.close(os.open(probe_file, os.O_CREAT | os.O_WRONLY, 0o600))
        probe_file.unlink()
    except OSError as e:
        hint = (" The Codex sandbox blocks this: run the same pi-task command with escalated permissions."
                if caller() == "codex" or os.environ.get("CODEX_SANDBOX_NETWORK_DISABLED") else "")
        die(f"cannot write {STATE_DIR}: {e.strerror}.{hint}")
    if not pi_bin():
        die("cannot find the pi command; set PI_TASK_PI")
    if not EXTENSION.is_file():
        die(f"the pi-task extension is missing: {EXTENSION}")


def get_text(a, what):
    if getattr(a, "file", None):
        text = sys.stdin.read() if a.file == "-" else Path(a.file).read_text(encoding="utf-8")
    elif a.text:
        text = " ".join(a.text)
        if text == "-":
            text = sys.stdin.read()
    elif not sys.stdin.isatty():
        text = sys.stdin.read()
    else:
        die(f"no {what}: pass it as arguments, with -f FILE, or on stdin", 2)
    text = text.strip()
    if not text:
        die(f"the {what} is empty", 2)
    return text


def check_slash(text):
    """None for text, the focus for /compact; dies for other slash commands."""
    if not is_command(text):
        return None
    cmd, _, rest = text.partition(" ")
    if cmd == "/compact":
        return rest.strip()
    die(f"{cmd} is a pi TUI command, and pi-task sends text. Use `{PROG} compact` or `{PROG} set`, "
        f"or type it in the window (`{PROG} show NAME`)", 2)


